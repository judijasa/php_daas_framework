# Deploy configuration template — the deployment target shared by every prod
# server listed in etc/machines.ini: PROD_USER and the DEPLOY_* paths are
# identical on all hosts.
#
# The real file is consumer-owned private data: keep it in a separate private
# config repo (never in the public history) and place it at etc/deploy.conf —
# copy this template and fill in the values. The framework sources it on the
# deploy machine (where it must be present) and replays its environment to
# every remote step, so the host never needs a copy of this file. It also
# ships the private files named in DEPLOY_PRIVATE_FILES (below) into the
# host's freshly swapped etc/.
#
# Database instances are no longer provisioned at deploy time — they
# are created by `ema create` (one instance per database) and the operator
# records the emitted connectivity in the consumer's manual reuter.ini (see
# doc/system/ema.md). DEPLOY_REUTER_INI points at that file.
#
# .env (generated, git-ignored) holds machine settings; this file holds the
# deployment target shared by every machine of the project.
#
# `gen-env` (run on the remote by pf-deploy on every deploy) projects the
# git-ignored .env from THIS file — there is
# no separate etc/env.prod anymore. The projection:
#   REPO_PATH      := DEPLOY_TARGET_DIR
#   REPO_LOG       := DEPLOY_LOG_DIR
#   REUTER_INI     := DEPLOY_REUTER_INI
#   EMA_TARGET     := prod (constant)
#
# .env stays MYSQL_*-free: the socket lives in
# the prod reuter.ini section (MYSQL_UNIX_PORT, recorded from `ema create`
# output). The app layer stays TCP-only.
#
# PROD_USER: unprivileged app user on the remote host. Choose a short,
# deliberate name — NOT the repo name (e.g. php_daas_framework -> daas). The
# user must already exist on the remote host with SSH access before the first
# deploy (see README "Deploying a consumer project" -> "Before the first
# deploy").
export PROD_USER=<app-user>

# DEPLOY_TARGET_DIR: remote repo location (identical on every prod host).
export DEPLOY_TARGET_DIR=/srv/apps/<app>

# DEPLOY_LOG_DIR: remote log dir (deploy_version.log lives here).
export DEPLOY_LOG_DIR=/var/log/<app>

# DEPLOY_REUTER_INI: path to the consumer's manual reuter.ini — one
# [<dbname>] section per database (SERVER/PORT/MYSQL_UNIX_PORT plus the
# consumer's <ACCOUNT>_PASSWORD keys), recorded from `ema create`'s output.
# gen-env writes it into .env as REUTER_INI; pf-deploy's db-check reads it to
# verify reachability. The file is the consumer's private data, and the repo
# dir is replaced on every deploy, so name it in DEPLOY_PRIVATE_FILES (below)
# and the framework ships it into the freshly swapped etc/.
export DEPLOY_REUTER_INI=/srv/apps/<app>/etc/reuter.ini

# DEPLOY_PRIVATE_FILES: space-separated etc/-relative private file names the
# framework ships from the deploy machine's etc/ into the freshly swapped
# etc/ on the host (whole, verbatim) — the only private files a host needs,
# typically just reuter.ini. Skipped if unset; the consumer must have
# materialized etc/ first (its own dev-init/fetch step).
# export DEPLOY_PRIVATE_FILES="reuter.ini"

# DEPLOY_NIX_RESULT_DIR: remote nix result parent.
export DEPLOY_NIX_RESULT_DIR=/usr/local/<app>

# DEPLOY_NIX_GCROOT: remote nix gcroot.
export DEPLOY_NIX_GCROOT=/nix/var/nix/gcroots/<app>

# Optional: consumer-specific provisioning command run on the remote AFTER
# the framework's generic provisioning (bin/pf-provision.sh) on `deploy`;
# skipped if unset.
# export DEPLOY_INIT_CMD="make prod-init"

# Optional cron config, consumed by the framework's built-in server steps: on
# every host, pf-deploy installs the `cron-manifest` output (filtered by that
# host's tags — a job runs only where its `scope` matches, and `host`-scoped
# jobs run everywhere) into CRON_FILE and restarts cron (after gen-env, so
# the manifest is never written against a stale or missing .env). Omit if the
# project has no cron; REQUIRED whenever the repo declares a `#[CronJob]`
# attribute — pf-deploy fails loudly when unset there.
# CRON_FILE: remote crontab file the manifest is installed to.
# export CRON_FILE=/etc/cron.d/<app>-orchestrator
# CRON_USER: user the cron entries run as (default: root).
# export CRON_USER=root
# CRON_NIX_BIN: optional PATH override for the cron entries (default:
# $DEPLOY_TARGET_DIR/vendor/bin:$DEPLOY_NIX_RESULT_DIR/result/bin, so both
# `phprun` from vendor/bin and `php` from the nix result resolve).
# export CRON_NIX_BIN=/srv/apps/<app>/vendor/bin:/usr/local/<app>/result/bin
