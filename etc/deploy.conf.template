# Project-static deploy configuration (COMMIT this file to the consumer repo).
# Copy from the framework's etc/deploy.conf.template, fill in the values, and
# commit it. `deploy` requires it at the repo root and fails loudly if missing.
#
# This is the common deploy config for every prod server listed in
# etc/machines.ini: PROD_USER and the DEPLOY_* paths are identical on all
# hosts. The DEPLOY_DB_* values apply only on the database host — the [prod]
# entry in etc/machines.ini that carries a `db:<name>` tag.
#
# .env (generated, git-ignored) holds machine settings; this file holds the
# deployment target shared by every machine of the project.
#
# `gen-env` (run on the remote by pf-deploy on every deploy) projects the
# git-ignored .env from THIS file — there is
# no separate etc/env.prod anymore. The projection:
#   REPO_PATH      := DEPLOY_TARGET_DIR
#   REPO_LOG       := DEPLOY_LOG_DIR
#   REUTER_INI     := /etc/<DEPLOY_DB_INSTANCE>/reuter.ini
#   EMA_TARGET     := prod (constant)
#
# .env stays MYSQL_*-free: the socket lives in
# the prod reuter.ini section — gen-reuter writes
# MYSQL_UNIX_PORT=$DEPLOY_DB_BASE/mysql.sock into each [<dbname>] section for
# the `ema` CLI (root/unix_socket auth). The app layer stays TCP-only.
#
# PROD_USER: unprivileged app user on the remote host. Choose a short,
# deliberate name — NOT the repo name (e.g. php_daas_framework -> daas). The
# user must already exist on the remote host with SSH access before the first
# deploy (see README "Deploying a consumer project" -> "Before the first
# deploy").
export PROD_USER=<app-user>

# DEPLOY_TARGET_DIR: remote repo location (identical on every prod host).
export DEPLOY_TARGET_DIR=/srv/apps/<app>

# DEPLOY_LOG_DIR: remote log dir (deploy_version.log and the MariaDB error
# log live here).
export DEPLOY_LOG_DIR=/var/log/<app>

# DEPLOY_DB_BASE: remote root of the per-project MariaDB instance (used only
# on the database host). The instance identity is derived from it by
# convention (same shape as the dev sandbox's var/mariadb):
#   datadir  = $DEPLOY_DB_BASE/data
#   socket   = $DEPLOY_DB_BASE/mysql.sock
#   pid-file = $DEPLOY_DB_BASE/mysql.pid
# gen-reuter writes MYSQL_UNIX_PORT=$DEPLOY_DB_BASE/mysql.sock into each prod
# reuter.ini section (for `ema create srv/<name>-<GUID>` root socket access on
# the DB host).
# Created and initialized by `deploy` (the framework's generic
# bin/pf-provision.sh) only on the database host; the daemon runs as PROD_USER
# via a systemd template unit (mariadb@<instance>), started exactly once and
# durable across reboots.
export DEPLOY_DB_BASE=/var/lib/<app>/mariadb

# DEPLOY_DB_INSTANCE: optional systemd unit instance name and config dir
# name (/etc/<instance>/my.cnf). Also names the production reuter.ini path
# (/etc/<instance>/reuter.ini) that `gen-env` writes into `.env` as
# REUTER_INI. Defaults to the basename of DEPLOY_TARGET_DIR; set it
# explicitly if that is not a good unit name.
# export DEPLOY_DB_INSTANCE=<app>

# DEPLOY_DB_PORT: REQUIRED on the database host — the TCP port the MariaDB
# instance listens on. Every prod script connects to the database over TCP
# (gen-reuter writes SERVER/PORT into the prod reuter.ini sections), on the
# DB host and on app-only hosts alike. Bind it to the ZeroTier IP via
# DEPLOY_DB_BIND.
# export DEPLOY_DB_PORT=3307

# DEPLOY_DB_BIND: address the daemon binds to. Defaults to 0.0.0.0 (all
# interfaces); set it to the DB host's ZeroTier IP to restrict access to
# the overlay network.
# export DEPLOY_DB_BIND=<zerotier-ip>

# DEPLOY_NIX_RESULT_DIR: remote nix result parent.
export DEPLOY_NIX_RESULT_DIR=/usr/local/<app>

# DEPLOY_NIX_GCROOT: remote nix gcroot.
export DEPLOY_NIX_GCROOT=/nix/var/nix/gcroots/<app>

# Optional: consumer-specific provisioning command run on the remote AFTER
# the framework's generic provisioning (bin/pf-provision.sh) on `deploy`;
# skipped if unset.
# export DEPLOY_INIT_CMD="make prod-init"

# Optional cron config, consumed by the framework's built-in server steps: on
# every host whose etc/machines.ini [prod] entry carries the `worker` tag,
# pf-deploy installs the `cron-manifest` output into CRON_FILE and restarts
# cron (after gen-env, so the manifest is never written against a stale or
# missing .env). Omit if the project has no cron; REQUIRED on `worker` hosts
# — pf-deploy fails loudly when unset there.
# CRON_FILE: remote crontab file the manifest is installed to.
# export CRON_FILE=/etc/cron.d/<app>-orchestrator
# CRON_USER: user the cron entries run as (default: root).
# export CRON_USER=root
# CRON_NIX_BIN: optional PATH override for the cron entries (default:
# $DEPLOY_TARGET_DIR/vendor/bin:$DEPLOY_NIX_RESULT_DIR/result/bin, so both
# `phprun` from vendor/bin and `php` from the nix result resolve).
# export CRON_NIX_BIN=/srv/apps/<app>/vendor/bin:/usr/local/<app>/result/bin
