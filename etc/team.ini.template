; Team member registry — one DB account per team member, reachable from any
; host on the trusted network. This file is private data: keep it in the
; consumer's private config repo and place it at etc/team.ini (see
; doc/system/consumer-config.md).
;
; Each section is one member and the section name IS that member's DB
; username. `password` is the member's password, passed verbatim to the
; account's IDENTIFIED BY clause.
;
; The remaining keys are hostname -> ZeroTier IP entries. `gen-grants` no
; longer reads them (it pins each member to `%`); a consumer keeps them only
; where it still uses the `member` source for the shared service account
; (doc/system/service-accounts.md). The former `subject` key (cert DN) is now
; read only by `gen-cert`.
;
;   `gen-grants <db>` turns each member into a password-authenticated
;   `member@'%'` DB account.

[john]
password = <member password>
john-workstation = 10.147.x.20
john-laptop      = 10.147.x.21

[jane]
password = <member password>
jane-workstation = 10.147.x.30
