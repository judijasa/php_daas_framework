; DB connection config consumed by Utils\Connectivity\Database.
;
; Sections are keyed by database name (the section header IS the database
; name), and the connector resolves a database to its [<dbname>] section:
;   admin  -> Database::admin($dbname)   (uses ADMIN_PASSWORD)
;   reader -> Database::reader($dbname)  (uses READER_PASSWORD)
;   public -> Database::public($dbname)  (connects without credentials)
;
; This file carries prod connectivity only, generated per database by
; gen-reuter from etc/machines.ini + etc/deploy.conf. The dev sandbox lives
; in var/reuter.local.ini (generated by 'ema init db <name>'), not here.
;
; Transport: the section is authoritative for the 'ema' CLI. When
; MYSQL_UNIX_PORT is set, ema connects via that socket (root/unix_socket
; auth); otherwise it uses SERVER/PORT over TCP. The app layer
; (Utils\Connectivity\Database) reads MYSQL_UNIX_PORT from .env, not from
; this file, so in prod it stays TCP-only (.env is MYSQL_*-free).

[mydb]
SERVER=10.147.x.10
PORT=3307
DBMS=mariadb
ADMIN_PASSWORD=
READER_PASSWORD=
MYSQL_UNIX_PORT=/path/to/mysql.sock
