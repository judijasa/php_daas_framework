; DB connection config consumed by Utils\Connectivity\Database.
;
; Section selection:
;   - EMA_TARGET=local (default) uses [local] (dev sandbox socket), or a
;     per-database [local:<dbname>] section when present.
;   - any other EMA_TARGET (e.g. prod) resolves [<dbname>] by the database
;     name passed to the connector (e.g. Database::admin('mydb')).
; The `gen-reuter` CLI refreshes the prod [<dbname>] sections from
; etc/machines.ini + etc/deploy.conf; the local sections are dev-side.
;
; The database name is NOT taken from here - it is passed to the connector
; methods (e.g. Database::admin('mydb')). SERVER / PORT and the passwords
; below are what this file provides.
;
;   admin  -> Database::admin($dbname)   (uses ADMIN_PASSWORD)
;   reader -> Database::reader($dbname)  (uses READER_PASSWORD)
;   public -> Database::public($dbname)  (connects without credentials)
;
; Transport: the section is authoritative for the `ema` CLI. When
; MYSQL_UNIX_PORT is set, ema connects via that socket (root/unix_socket
; auth); otherwise it uses SERVER/PORT over TCP. The app layer
; (Utils\Connectivity\Database) reads MYSQL_UNIX_PORT from .env, not from
; this file, so in prod it stays TCP-only (.env is MYSQL_*-free).

[local]
SERVER=localhost
PORT=3306
DBNAME=test
DBMS=mariadb
ADMIN_PASSWORD=
READER_PASSWORD=
MYSQL_UNIX_PORT=var/mariadb/mysql.sock

; Example: a second local database on the dev sandbox socket.
[local:mydb]
SERVER=localhost
PORT=3306
DBNAME=mydb
DBMS=mariadb
ADMIN_PASSWORD=
READER_PASSWORD=
MYSQL_UNIX_PORT=var/mariadb/mysql.sock

; Prod sections are generated per database by gen-reuter (one per mapped
; database in etc/machines.ini [prod]). gen-reuter writes MYSQL_UNIX_PORT
; = $DEPLOY_DB_BASE/mysql.sock (the DB host's local socket) so
; `ema init db <name>` run on the DB host authenticates as root over the
; socket; the app layer ignores this key and stays on TCP.
[mydb]
SERVER=10.147.x.10
PORT=3307
DBNAME=mydb
DBMS=mariadb
ADMIN_PASSWORD=
READER_PASSWORD=
MYSQL_UNIX_PORT=/path/to/mysql.sock
