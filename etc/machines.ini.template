# Machine registry: prod machines only.
# This file is private data: keep it in the consumer's private config repo and
# place it at etc/machines.ini (see doc/system/consumer-config.md). It is
# dev/deploy-time only — `pf-deploy.sh` reads the [prod] roster locally, on the
# deploy machine, and `machines.ini` is never shipped to a host; the dev-machine
# `DBUSER` mapping now lives in etc/team.ini (see etc/team.ini.template +
# doc/system/team-db-users.md), not here.
#
# [prod] prod deploy targets. Each key is the server's ZeroTier IP (the same
#        address `pf-deploy.sh` uses for SSH). The value is a comma-separated
#        list of `tag[:name]` tokens:
#          bare tag    `web`       -> boolean flag (a deploy step on this host)
#          bare tag    `worker`    -> a bare tag data jobs use as their cron
#                                     scope
#          named tag   `db:mydb`   -> a `db` resource named `mydb`
#        `db` is the framework's built-in tag: `db:<name>` names a database
#        and enforces the one-to-one server mapping (the instance itself is
#        provisioned by `ema create`; db-check verifies it via the host's own
#        `mariadb@*` units, not this roster). Every tag doubles as a cron
#        scope: a `#[CronJob]` declares `scope: <tag[:name]>` (or `scope:
#        host` to run on every host), and `cron-manifest --host-tags
#        <tokens>` installs only jobs whose scope matches this host's tokens
#        — a `host`-scoped job runs on every host. `worker` is an ordinary
#        bare tag in that matcher, nothing special-cases it. Every other tag
#        is consumer-owned and carried through generically. A host with a
#        `db:<name>` token is a database host; an empty value is a code-only
#        server (it deploys the codebase but runs no tagged step).
#
#        Constraint: a named token may appear on exactly ONE server
#        (`db:mydb` and `web:mysite` are independent). Bare flags carry no
#        name, hence no uniqueness constraint. A server may host no database
#        (code-only), one database, or several databases (one MariaDB
#        instance each, created by `ema create`).

[prod]
# 10.147.x.10=db:mydb, web, worker
# 10.147.x.11=worker
