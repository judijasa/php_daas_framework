# Machine registry: prod machines only.
# This file is private data: keep it in a private config repo and inject it via
# .private-source into etc/machines.ini (see doc/system/private-config.md) —
# never a real file at that path, which would shadow the injected data instead
# of being overwritten. `pf-deploy.sh` and
# `deploy-private-config` read the [prod] roster (locally, on the deploy
# machine — `machines.ini` is never shipped to a host); the dev-machine
# `DBUSER` mapping now lives in etc/team.ini (see etc/team.ini.template +
# doc/system/team-db-users.md), not here.
#
# [prod] prod deploy targets. Each key is the server's ZeroTier IP (the same
#        address `pf-deploy.sh` uses for SSH). The value is a comma-separated
#        list of `tag[:name]` tokens:
#          bare tag    `web`       -> boolean flag (a deploy step on this host)
#          bare tag    `worker`    -> boolean flag (framework built-in: installs
#                                     the cron manifest on every deploy)
#          named tag   `db:mydb`   -> a `db` resource named `mydb`
#        `db` and `worker` are the framework's built-in tags: `db:<name>`
#        names a database and enforces the one-to-one server mapping (the
#        instance itself is provisioned by `ema create`; db-check verifies it
#        via the host's own `mariadb@*` units, not this roster), and bare
#        `worker` installs the
#        `cron-manifest` output into CRON_FILE (etc/deploy.conf) on every
#        deploy. Every other tag is consumer-owned and carried through
#        generically. A host with a `db:<name>` token is a database host; an
#        empty value is a code-only server (it deploys the codebase but runs
#        no tagged step).
#
#        Constraint: a named token may appear on exactly ONE server
#        (`db:mydb` and `web:mysite` are independent). Bare flags carry no
#        name, hence no uniqueness constraint. A server may host no database
#        (code-only), one database, or several databases (one MariaDB
#        instance each, created by `ema create`).

[prod]
# 10.147.x.10=db:mydb, web, worker
# 10.147.x.11=worker
