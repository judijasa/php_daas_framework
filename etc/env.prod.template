# Production runtime configuration (COMMIT this file as etc/env.prod).
# Copy from etc/env.prod.template, fill in the values, and commit it.
# `gen-env` regenerates the git-ignored .env from it on every deploy;
# the framework fails loudly if the file is missing or a content line is
# lost in the output. gen-env does NOT validate this file's completeness —
# every key below must be present, or phprun silently falls back to its
# defaults at runtime.
#
# Same contract as the dev .env generated by `make dev-init`. Values must
# match the equivalent deploy-time paths in etc/deploy.conf:
#   REPO_PATH = DEPLOY_TARGET_DIR, REPO_LOG = DEPLOY_LOG_DIR.
# REUTER_INI points to the production DB config (e.g. /etc/<app>/reuter.ini),
# and EMA_TARGET selects the matching section in it.
export REPO_PATH=/srv/apps/<app>
export REPO_LOG=/var/log/<app>
export REUTER_INI=/etc/<app>/reuter.ini
export EMA_TARGET=prod
