#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-reuter - refresh reuter.ini connectivity sections from the machine
// registry (etc/machines.ini) and the deploy config (etc/deploy.conf). The
// framework owns the mechanism; the consumer owns the data (the two etc/
// files and the target ini path).
//
// It writes ONE section per prod database, keyed by the database name, so
// both the framework Database class and the `ema` CLI resolve a database to
// the server that hosts it. It fills only the non-secret keys (SERVER, PORT,
// DBNAME, DBMS) and preserves credentials (ADMIN_PASSWORD, READER_PASSWORD)
// and every other section/key already present in the file (including
// [local], the dev sandbox section).
//
// Constraint enforced here: each database name must map to exactly one server.
//
// Usage: gen-reuter [target.ini]   (default: $PWD/etc/reuter.ini)

function load_deploy_conf(string $path): array
{
    $out = [];
    if (!is_file($path)) {
        return $out;
    }
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') {
            continue;
        }
        if (preg_match('/^(?:export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/', $line, $m) === 1) {
            $out[$m[1]] = trim($m[2]);
        }
    }
    return $out;
}

function db_servers(string $machinesPath): array
{
    $out = [];
    if (!is_file($machinesPath)) {
        return $out;
    }
    $cnf = parse_ini_file($machinesPath, true, INI_SCANNER_RAW);
    if ($cnf === false || !isset($cnf['prod'])) {
        return $out;
    }
    foreach ($cnf['prod'] as $host => $list) {
        if (!is_string($list) || trim($list) === '') {
            continue;
        }
        foreach (explode(',', $list) as $raw) {
            $db = trim($raw);
            if ($db === '') {
                continue;
            }
            if (isset($out[$db])) {
                fwrite(STDERR, 'gen-reuter: database ' . $db . ' is listed more than once in etc/machines.ini [prod] (a database maps to exactly one server).' . PHP_EOL);
                exit(1);
            }
            $out[$db] = array('server' => $host, 'name' => $db);
        }
    }
    return $out;
}

function ini_quote(string $value): string
{
    $dq = chr(34);
    $bs = chr(92);
    $specials = chr(9) . chr(10) . chr(13) . ' ;#' . $dq . chr(39) . '=';
    if ($value === '' || strpbrk($value, $specials) !== false) {
        $value = str_replace($bs, $bs . $bs, $value);
        $value = str_replace($dq, $bs . $dq, $value);
        return $dq . $value . $dq;
    }
    return $value;
}

function ini_write(array $cnf): string
{
    $out = '# Generated by gen-reuter; edit etc/machines.ini, not the prod sections here.' . PHP_EOL;
    foreach ($cnf as $section => $keys) {
        $out .= PHP_EOL . '[' . $section . ']' . PHP_EOL;
        foreach ($keys as $k => $v) {
            $out .= $k . '=' . ini_quote((string) $v) . PHP_EOL;
        }
    }
    return $out;
}

function main(): int
{
    $root = getcwd();
    $target = $argv[1] ?? $root . '/etc/reuter.ini';

    $mapping = db_servers($root . '/etc/machines.ini');
    if (count($mapping) === 0) {
        fwrite(STDERR, 'gen-reuter: no [prod] databases in etc/machines.ini; leaving ' . $target . ' untouched' . PHP_EOL);
        return 0;
    }

    $deploy = load_deploy_conf($root . '/etc/deploy.conf');
    $port = $deploy['DEPLOY_DB_PORT'] ?? '3306';

    $cnf = is_file($target) ? (parse_ini_file($target, true, INI_SCANNER_RAW) ?: []) : [];
    foreach ($mapping as $db => $info) {
        if (!isset($cnf[$db]) || !is_array($cnf[$db])) {
            $cnf[$db] = [];
        }
        $admin = $cnf[$db]['ADMIN_PASSWORD'] ?? '';
        $reader = $cnf[$db]['READER_PASSWORD'] ?? '';

        $cnf[$db]['SERVER'] = $info['server'];
        $cnf[$db]['PORT'] = $port;
        $cnf[$db]['DBNAME'] = $info['name'];
        $cnf[$db]['DBMS'] = 'mariadb';
        $cnf[$db]['ADMIN_PASSWORD'] = $admin;
        $cnf[$db]['READER_PASSWORD'] = $reader;
    }

    if (file_put_contents($target, ini_write($cnf)) === false) {
        fwrite(STDERR, 'gen-reuter: could not write ' . $target . PHP_EOL);
        return 1;
    }
    fwrite(STDOUT, '    Wrote prod connectivity for ' . count($mapping) . ' database(s) into ' . $target . PHP_EOL);
    return 0;
}

exit(main());
