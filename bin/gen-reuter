#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-reuter - refresh reuter.ini connectivity sections from the machine
// registry (etc/machines.ini) and the deploy config (etc/deploy.conf). The
// framework owns the mechanism; the consumer owns the data (the two etc/
// files and the target ini path).
//
// It writes ONE section per prod database, keyed by the database name, so
// both the framework Database class and the `ema` CLI resolve a database to
// the server that hosts it. It fills the connectivity keys (SERVER, PORT,
// DBMS, and MYSQL_UNIX_PORT - the DB host's local socket path, so
// `ema init db <name>` run on the DB host can authenticate as root over the
// socket) and preserves the credentials (ADMIN_PASSWORD, READER_PASSWORD).
// [local]/[local:<db>] sections are dropped: the dev sandbox lives in
// var/reuter.local.ini (generated by `ema init db <name>`). MYSQL_UNIX_PORT
// is the only socket signal the prod sections carry: the prod .env stays
// MYSQL_*-free so the app layer (Database.php) remains TCP-only.
//
// Constraint enforced here: each database name must map to exactly one server.
//
// Usage: gen-reuter [target.ini]   (default: $PWD/etc/reuter.ini)

function load_deploy_conf(string $path): array
{
    $out = [];
    if (!is_file($path)) {
        return $out;
    }
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') {
            continue;
        }
        if (preg_match('/^(?:export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/', $line, $m) === 1) {
            $out[$m[1]] = trim($m[2]);
        }
    }
    return $out;
}

// db_servers() collects the `db:<name>` tokens from etc/machines.ini [prod]
// (via the shared pf-roster CLI — the same parse pf-deploy.sh and the
// consumer deploy wrapper use) and maps each database name to its host.
function db_servers(string $machinesPath): array
{
    $out = [];
    if (!is_file($machinesPath)) {
        return $out;
    }
    $roster = dirname(__FILE__) . '/pf-roster';
    $lines = [];
    $code = 0;
    exec(escapeshellarg($roster) . ' --db-servers', $lines, $code);
    if ($code !== 0) {
        // pf-roster --db-servers exits non-zero when a database is listed on
        // two servers; it already wrote the diagnostic to stderr.
        exit(1);
    }
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || strpos($line, '=') === false) {
            continue;
        }
        [$name, $server] = explode('=', $line, 2);
        if ($name === '' || $server === '') {
            continue;
        }
        $out[$name] = array('server' => $server, 'name' => $name);
    }
    return $out;
}

function ini_quote(string $value): string
{
    $dq = chr(34);
    $bs = chr(92);
    $specials = chr(9) . chr(10) . chr(13) . ' ;#' . $dq . chr(39) . '=';
    if ($value === '' || strpbrk($value, $specials) !== false) {
        $value = str_replace($bs, $bs . $bs, $value);
        $value = str_replace($dq, $bs . $dq, $value);
        return $dq . $value . $dq;
    }
    return $value;
}

function ini_write(array $cnf): string
{
    $out = '# Generated by gen-reuter; edit etc/machines.ini, not the prod sections here.' . PHP_EOL;
    foreach ($cnf as $section => $keys) {
        $out .= PHP_EOL . '[' . $section . ']' . PHP_EOL;
        foreach ($keys as $k => $v) {
            $out .= $k . '=' . ini_quote((string) $v) . PHP_EOL;
        }
    }
    return $out;
}

function main(): int
{
    $root = getcwd();
    $target = $argv[1] ?? $root . '/etc/reuter.ini';

    $mapping = db_servers($root . '/etc/machines.ini');
    if (count($mapping) === 0) {
        fwrite(STDERR, 'gen-reuter: no [prod] databases in etc/machines.ini; leaving ' . $target . ' untouched' . PHP_EOL);
        return 0;
    }

    $deploy = load_deploy_conf($root . '/etc/deploy.conf');
    if (!isset($deploy['DEPLOY_DB_PORT'])) {
        fwrite(STDERR, 'gen-reuter: DEPLOY_DB_PORT is not set in etc/deploy.conf; a database host must expose TCP on the ZeroTier interface.' . PHP_EOL);
        exit(1);
    }
    $port = $deploy['DEPLOY_DB_PORT'];
    // The prod sections carry the DB host's local socket path so `ema init
    // db <name>` (run on the DB host) can authenticate as root over the
    // socket (prod root = unix_socket auth). The app layer reads .env, not
    // this key, and .env is MYSQL_*-free, so it stays TCP-only.
    $dbBase = $deploy['DEPLOY_DB_BASE'] ?? '';

    $cnf = is_file($target) ? (parse_ini_file($target, true, INI_SCANNER_RAW) ?: []) : [];
    // gen-reuter owns only the prod [<dbname>] sections; the dev sandbox
    // lives in var/reuter.local.ini (generated by 'ema init db <name>'), so
    // legacy [local]/[local:<db>] sections are dropped here.
    foreach (array_keys($cnf) as $section) {
        if ($section === 'local' || strpos($section, 'local:') === 0) {
            unset($cnf[$section]);
        }
    }
    foreach ($mapping as $db => $info) {
        $existing = (isset($cnf[$db]) && is_array($cnf[$db])) ? $cnf[$db] : [];
        $cnf[$db] = array(
            'SERVER' => $info['server'],
            'PORT' => $port,
            'DBMS' => 'mariadb',
            'ADMIN_PASSWORD' => $existing['ADMIN_PASSWORD'] ?? '',
            'READER_PASSWORD' => $existing['READER_PASSWORD'] ?? '',
        );
        if ($dbBase !== '') {
            $cnf[$db]['MYSQL_UNIX_PORT'] = $dbBase . '/mysql.sock';
        }
    }

    if (file_put_contents($target, ini_write($cnf)) === false) {
        fwrite(STDERR, 'gen-reuter: could not write ' . $target . PHP_EOL);
        return 1;
    }
    fwrite(STDOUT, '    Wrote prod connectivity for ' . count($mapping) . ' database(s) into ' . $target . PHP_EOL);
    return 0;
}

exit(main());
