#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-reuter - refresh the [prod] connectivity section of a reuter.ini from
// the machine registry (etc/machines.ini) and the deploy config
// (etc/deploy.conf). The framework owns the mechanism; the consumer owns the
// data (the two etc/ files and the target ini path).
//
// etc/reuter.ini stays the single connectivity contract consumed by both the
// framework Database class and the `ema` CLI. This tool fills only the
// non-secret prod keys (SERVER, PORT, DBNAME, DBMS) and preserves the
// credentials (ADMIN_PASSWORD, READER_PASSWORD) and every other section/key
// already present in the file.
//
// Usage: gen-reuter [target.ini]   (default: $PWD/etc/reuter.ini)

function load_deploy_conf(string $path): array
{
    $out = [];
    if (!is_file($path)) {
        return $out;
    }
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') {
            continue;
        }
        if (preg_match('/^(?:export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/', $line, $m) === 1) {
            $out[$m[1]] = trim($m[2]);
        }
    }
    return $out;
}

function db_mapping(string $machinesPath): ?array
{
    if (!is_file($machinesPath)) {
        return null;
    }
    $cnf = parse_ini_file($machinesPath, true, INI_SCANNER_RAW);
    if ($cnf === false || !isset($cnf['prod'])) {
        return null;
    }
    foreach ($cnf['prod'] as $host => $db) {
        if (is_string($db) && $db !== '') {
            return [$host, $db];
        }
    }
    return null;
}

function ini_quote(string $value): string
{
    $dq = chr(34);
    $bs = chr(92);
    $specials = chr(9) . chr(10) . chr(13) . ' ;#' . $dq . chr(39) . '=';
    if ($value === '' || strpbrk($value, $specials) !== false) {
        $value = str_replace($bs, $bs . $bs, $value);
        $value = str_replace($dq, $bs . $dq, $value);
        return $dq . $value . $dq;
    }
    return $value;
}

function ini_write(array $cnf): string
{
    $out = '# Generated by gen-reuter; edit etc/machines.ini, not the prod keys here.' . PHP_EOL;
    foreach ($cnf as $section => $keys) {
        $out .= PHP_EOL . '[' . $section . ']' . PHP_EOL;
        foreach ($keys as $k => $v) {
            $out .= $k . '=' . ini_quote((string) $v) . PHP_EOL;
        }
    }
    return $out;
}

function main(): int
{
    $root = getcwd();
    $target = $argv[1] ?? $root . '/etc/reuter.ini';

    $mapping = db_mapping($root . '/etc/machines.ini');
    if ($mapping === null) {
        fwrite(STDERR, 'gen-reuter: no [prod] DB host in etc/machines.ini; leaving ' . $target . ' untouched' . PHP_EOL);
        return 0;
    }
    [$dbHost, $dbName] = $mapping;

    $deploy = load_deploy_conf($root . '/etc/deploy.conf');
    $port = $deploy['DEPLOY_DB_PORT'] ?? '3306';

    $cnf = is_file($target) ? (parse_ini_file($target, true, INI_SCANNER_RAW) ?: []) : [];
    if (!isset($cnf['prod']) || !is_array($cnf['prod'])) {
        $cnf['prod'] = [];
    }

    $admin = $cnf['prod']['ADMIN_PASSWORD'] ?? '';
    $reader = $cnf['prod']['READER_PASSWORD'] ?? '';

    $cnf['prod']['SERVER'] = $dbHost;
    $cnf['prod']['PORT'] = $port;
    $cnf['prod']['DBNAME'] = $dbName;
    $cnf['prod']['DBMS'] = 'mariadb';
    $cnf['prod']['ADMIN_PASSWORD'] = $admin;
    $cnf['prod']['READER_PASSWORD'] = $reader;

    if (file_put_contents($target, ini_write($cnf)) === false) {
        fwrite(STDERR, 'gen-reuter: could not write ' . $target . PHP_EOL);
        return 1;
    }
    fwrite(STDOUT, '    Wrote prod connectivity (SERVER=' . $dbHost . ' PORT=' . $port . ' DBNAME=' . $dbName . ') into ' . $target . PHP_EOL);
    return 0;
}

exit(main());
