#!/usr/bin/env bash

set -euo pipefail

# Load runtime configuration from a .env in the current working directory
# (the consumer repo root). This is the canonical per-environment config:
# cron jobs and manual runs `cd` into the repo before invoking phprun.
# Values in .env override anything already in the environment.
if [[ -f "$PWD/.env" ]]; then
    set -a
    . "$PWD/.env"
    set +a
fi

# Resolve repository and log paths. Consumers provide them through the
# environment: the .env above, the nix dev shell, or a nix-built wrapper
# that bakes them at build time.
REPO_PATH="${PHPRUN_REPO_PATH:-}"
LOG_PATH="${PHPRUN_LOG_PATH:-}"

if [[ -z "$REPO_PATH" || -z "$LOG_PATH" ]]; then
    echo "phprun: PHPRUN_REPO_PATH/PHPRUN_LOG_PATH must be set" >&2
    exit 1
fi

parent=$(ps -o comm= -p "$PPID")
if [[ "$parent" == "cron" || "$parent" == "crond" ]]; then
    cd "$REPO_PATH"
elif [[ "$PWD" != "$REPO_PATH" ]]; then
    echo "This command must be executed from the repository's root directory." >&2
    exit 1
fi

ARG="${1:-}"

if [[ -z "$ARG" || "$ARG" != *:* ]]; then
    echo "Usage: phprun 'path/to/script.php:my_agent(args)'" >&2
    exit 1
fi

SCRIPT="${ARG%%:*}"
SCRIPT_NAME=$(basename "$SCRIPT" .php)
DIR_PREFIX=$(dirname "$SCRIPT" | tr '/' '_')
LOG_FILE="${LOG_PATH}/${DIR_PREFIX}_${SCRIPT_NAME}.log"

touch -a "$LOG_FILE"

if [ -t 1 ]; then
    exec > >(tee -a "$LOG_FILE") 2>&1
else
    exec >> "$LOG_FILE" 2>&1
fi

# Locate the PHP runner relative to this wrapper's real location, resolving
# nix store and vendor/bin symlinks.
RUNNER_PHP="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/src/phprun.php"

php "$RUNNER_PHP" "$ARG"
