#!/usr/bin/env bash
# fetch-private-data — inject git-ignored private operational config into the
# consumer repo's etc/ via symlinks.
#
# The private repo's committed content is the single source of truth on every
# machine that can reach git; nothing runs on a loose, uncommitted copy. There
# is exactly one retrieval mechanism:
#
#   .private-source  ->  PRIVATE_DATA_GIT (+ optional PRIVATE_DATA_REF), the
#                        private config repo URL, fetched on demand into
#                        var/private-data (dev/deploy machines).
#
# `reuter.ini` is the only required private file; `machines.ini` and
# `team.ini` are wired only when the private source provides them (dev alone —
# they are never shipped to prod).
#
# When `.private-source` is absent, this is a no-op by default (the public
# repo stays fully functional without private data). On prod — no git, no
# `.private-source` — it resolves the stable per-app dir from
# `etc/deploy.conf`'s `DEPLOY_PRIVATE_CONFIG_DIR` and links `reuter.ini` from
# there into `etc/`. A present `.private-source` that sets no
# `PRIVATE_DATA_GIT` is an error, not a silent skip.
#
# Injection is a symlink, never a copy: `etc/<f>` points into the source, so a
# later run refreshes the data through the link. A real file at `etc/<f>`
# shadows the private data instead — reported loudly, never overwritten (that
# silent skip is how a machine ends up running stale private config while
# believing it is current).
#
# Access control on the private repo is the real security boundary; the
# untracked pointer only keeps the private repo's identity out of the public
# history.
#
# Usage: fetch-private-data [target-dir]   (default: $PWD)

set -euo pipefail

ROOT="$(cd "${1:-$PWD}" && pwd)"
SOURCE_FILE="$ROOT/.private-source"

# Wire src into etc/<f> as a symlink, honouring the invariant:
#   - an up-to-date link (already pointing at src) is kept;
#   - a stale or dangling link is re-pointed at src;
#   - a real file shadows the private data and is NEVER overwritten (warn).
wire() {
    local src="$1" dst="$2" cur
    if [[ -L "$dst" ]]; then
        cur="$(readlink "$dst" 2>/dev/null || true)"
        if [[ "$cur" == "$src" ]]; then
            return 0
        fi
        echo "fetch-private-data: re-pointing $dst -> $src (was -> $cur)" >&2
        rm -f "$dst"
        ln -s "$src" "$dst"
    elif [[ -e "$dst" ]]; then
        echo "fetch-private-data: WARNING: $dst is a real file; it shadows the private data at $src and is NOT overwritten." >&2
    else
        ln -s "$src" "$dst"
    fi
}

SOURCE_DIR=""
if [[ -f "$SOURCE_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$SOURCE_FILE"
    set +a

    # Git is the only retrieval mechanism: a pointer without PRIVATE_DATA_GIT
    # is an error, not a silent skip.
    if [[ -z "${PRIVATE_DATA_GIT:-}" ]]; then
        echo "fetch-private-data: .private-source sets no PRIVATE_DATA_GIT (required)." >&2
        exit 1
    fi

    SOURCE_DIR="$ROOT/var/private-data"
    REF="${PRIVATE_DATA_REF:-main}"
    if [[ -d "$SOURCE_DIR/.git" ]]; then
        git -C "$SOURCE_DIR" fetch --quiet origin "$REF"
        git -C "$SOURCE_DIR" checkout --quiet --detach FETCH_HEAD
    else
        mkdir -p "$ROOT/var"
        git clone --quiet "$PRIVATE_DATA_GIT" "$SOURCE_DIR"
        git -C "$SOURCE_DIR" checkout --quiet --detach "$REF"
    fi
    SOURCE_DIR="$(cd "$SOURCE_DIR" && pwd)"
else
    # No .private-source: prod resolves the stable per-app dir from
    # etc/deploy.conf when it is present. On a dev/deploy machine that dir
    # simply does not exist, so this stays a no-op there.
    if [[ -f "$ROOT/etc/deploy.conf" ]]; then
        set -a
        # shellcheck disable=SC1090
        . "$ROOT/etc/deploy.conf"
        set +a
    fi
    if [[ -z "${DEPLOY_PRIVATE_CONFIG_DIR:-}" ]]; then
        exit 0
    fi
    SOURCE_DIR="$DEPLOY_PRIVATE_CONFIG_DIR"
    if [[ ! -d "$SOURCE_DIR" ]]; then
        exit 0
    fi
fi

# reuter.ini is the only required file: the app cannot resolve a database
# without it. machines.ini/team.ini are wired only when provided (dev).
mkdir -p "$ROOT/etc"
for f in reuter.ini machines.ini team.ini; do
    src="$SOURCE_DIR/$f"
    if [[ ! -f "$src" ]]; then
        if [[ "$f" == "reuter.ini" ]]; then
            echo "fetch-private-data: private source $SOURCE_DIR has no reuter.ini (required)." >&2
            exit 1
        fi
        continue
    fi
    wire "$src" "$ROOT/etc/$f"
done
