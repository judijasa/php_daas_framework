#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-service-accounts — reconcile passwordless, host-pinned service accounts
// and roles from the shared pkg/roles-<GUID> declaration (RolesConfig),
// etc/team.ini (the `member` source), etc/machines.ini (tag sources) and the
// pkg/<db>.roles-<GUID> per-database grant package. The framework owns the
// mechanism (declaration format + reconcile); the consumer owns the data (its
// role definitions, per-database grants, account/source mapping, team roster,
// host registry, allow-list and role namespace) and the account model — one
// shared account pinned to many sources, several accounts with disjoint
// sources, or anything in between. No account name, role name, grant or
// source is hardcoded here.
//
// Reconcile is closed-world on role *memberships* (not GRANT privileges): the
// desired state per account per host is the union of the roles for that
// host's sources; excess roles are revoked and undeclared accounts/roles are
// dropped. See doc/system/service-accounts.md for the full contract.
//
// Emits transient SQL (never persisted) and, unless -n/--dry-run, applies it
// through `ema mariadb <db>`, with EMA_TARGET=prod pinned: this is a prod-only
// reconcile, so an operator shell in sandbox mode must not redirect it.
//
// The CLI runs on the operator machine — the roster's home — and bridges to the
// instance's host over `ssh root@<host>`, running the deployed repo's own ema
// there, where the section's socket and root (unix_socket auth) are local. The
// host is the one carrying the `db:<name>` roster token (the framework's
// one-to-one server mapping); the DB host itself carries no roster, so there
// the same call runs locally, as before. Only the SQL crosses the network: the
// roster this CLI plans from (etc/team.ini, etc/machines.ini, pkg/*) stays on
// the machine that runs it, and the reconcile needs no database account of its
// own — the connection is the host's root over the instance's socket.
//
// Apply order is fail-open: roles + grants, then accounts + role grants, then
// revoke (excess roles, then direct grants), then drop. A partial failure
// leaves a host holding a superset (never locked out); re-running converges.
//
// Usage: gen-service-accounts <db> [-n|--dry-run] [-h|--help]

const HELP = <<<'TXT'
Usage: gen-service-accounts <db> [flags]

Reconcile passwordless, host-pinned service accounts and roles for one
database, from the shared pkg/roles-<GUID> declaration (RolesConfig),
etc/team.ini + etc/machines.ini, and pkg/<db>.roles-<GUID>.

  <db>              database name (resolves pkg/<db>.roles-<GUID>).
  -n, --dry-run     print the reconcile SQL without applying it.
  -h, --help        show this help.

Run from the repo root on the operator machine: the roster is read here, and
the SQL is applied on the database host — the one carrying the `db:<name>`
token in etc/machines.ini — as root over ssh, through the deployed repo's own
ema and the instance's local socket, with the host's nix result bin
(DEPLOY_NIX_RESULT_DIR, from etc/deploy.conf) on PATH, where its php lives.

The shared pkg/roles-<GUID>/default.php returns a PackageConfig carrying a
RolesConfig: sources (source -> role), accounts (account -> sources) and,
optionally, allowlist (accounts never dropped) and require (a TLS/cert clause,
e.g. 'X509', emitted as `REQUIRE <value>` on every account). A source is
`member` (team.ini IPs) or a machines.ini tag.
TXT;

function pkg_package_dir(string $root, string $name): ?string
{
    $dir = $root . '/pkg/' . $name;
    return is_dir($dir) ? $dir : null;
}

function find_grants_package(string $root, string $db): ?string
{
    $matches = glob($root . '/pkg/' . $db . '.roles-*') ?: [];
    $matches = array_values(array_filter($matches, 'is_dir'));
    if (count($matches) === 1) {
        return $matches[0];
    }
    if (count($matches) === 0) {
        fwrite(STDERR, "gen-service-accounts: no pkg/{$db}.roles-<GUID> package found\n");
    } else {
        fwrite(STDERR, "gen-service-accounts: multiple pkg/{$db}.roles-<GUID> packages found; keep one\n");
    }
    return null;
}

// The shared roles package is the grants package's `roles-<GUID>` dependency.
function find_shared_roles_package(string $root, string $grantsDir): ?string
{
    foreach (package_dependencies($grantsDir) as $dep) {
        if (strpos($dep, 'roles-') === 0) {
            $dir = pkg_package_dir($root, $dep);
            if ($dir !== null) {
                return $dir;
            }
        }
    }
    return null;
}

// Load a package's default.php and return the Ema\Config\PackageConfig object
// it yields. The migrated value file returns a config object; a missing or
// legacy (variable-assigning) file yields null (read as an empty declaration).
function package_config(string $dir): ?\Ema\Config\PackageConfig
{
    $default = $dir . '/default.php';
    if (!is_file($default)) {
        return null;
    }
    $config = include $default;
    return $config instanceof \Ema\Config\PackageConfig ? $config : null;
}

// The schema an instance serves: read from the srv/<name>-<GUID> package's
// DatabaseConfig `dbname` (a primary declares dbname = its instance; a replica
// declares dbname = the primary's schema). Falls back to the instance name
// when no single srv package declares one (a legacy instance predating
// package-keyed naming, or a primary whose dbname equals its name).
function srv_dbname(string $root, string $instance): string
{
    $matches = glob($root . '/srv/' . $instance . '-*/') ?: [];
    $matches = array_values(array_filter($matches, 'is_dir'));
    if (count($matches) === 1) {
        $default = $matches[0] . '/default.php';
        if (is_file($default)) {
            $config = include $default;
            if ($config instanceof \Ema\Config\DatabaseConfig && $config->dbname !== '') {
                return $config->dbname;
            }
        }
    }
    return $instance;
}

// The declared dependencies, already a list: PackageConfig types the field as
// `list<string>`, so it needs no re-indexing here.
function package_dependencies(string $dir): array
{
    $config = package_config($dir);
    return $config === null ? [] : $config->dependencies;
}

// Load the shared roles package's optional declaration (the nested RolesConfig
// on its PackageConfig). Absent fields fall back to the gen-grants shape (no
// service accounts). Values are validated/coerced so the result is a clean
// typed shape regardless of what default.php sets.
//
// @return array{sources: array<string,string>, accounts: array<string,array<int,string>>, allowlist: array<int,string>, require: ?string}
function package_declaration(string $dir): array
{
    $roles = package_config($dir)?->roles;
    $sources = $roles->sources ?? [];
    $accounts = $roles->accounts ?? [];
    $allowlist = $roles->allowlist ?? [];
    $require = $roles->require ?? null;

    $src = [];
    foreach ($sources as $k => $v) {
        if (is_string($v)) {
            $src[(string) $k] = $v;
        }
    }

    $acct = [];
    foreach ($accounts as $k => $v) {
        if (is_array($v)) {
            $list = [];
            foreach ($v as $item) {
                if (is_string($item)) {
                    $list[] = $item;
                }
            }
            $acct[(string) $k] = $list;
        }
    }

    // root/mariadb.sys form an always-on safety floor: the closed-world drop
    // must never remove the instance's own engine-internal accounts. Accounts
    // the consumer creates itself (e.g. `replication` via replica-bootstrap)
    // are not covered here — declare them in the allowlist field, which
    // extends (never replaces) this floor.
    $allow = ['root', 'mariadb.sys'];
    foreach ($allowlist as $item) {
        if (is_string($item)) {
            $allow[] = $item;
        }
    }
    $allow = array_values(array_unique($allow));

    return ['sources' => $src, 'accounts' => $acct, 'allowlist' => $allow, 'require' => $require];
}

function read_upgrade_sql(string $dir): string
{
    $sql = is_file($dir . '/upgrade.sql') ? file_get_contents($dir . '/upgrade.sql') : '';
    return $sql === false ? '' : $sql;
}

// Extract role names from CREATE ROLE [IF NOT EXISTS] <name> statements.
function extract_roles(string $sql): array
{
    if (preg_match_all('/\bCREATE\s+ROLE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z0-9_]+)/i', $sql, $m) === false) {
        return [];
    }
    return array_values(array_unique($m[1]));
}

// Extract role names that hold a GRANT on this database, from the per-database
// grants package: GRANT <priv> ON {{dbname}}.* TO <role>.
function extract_grantee_roles(string $sql): array
{
    if (preg_match_all('/\bON\s+\{\{dbname\}\}\.\*\s+TO\s+([A-Za-z0-9_]+)/i', $sql, $m) === false) {
        return [];
    }
    return array_values(array_unique($m[1]));
}

// etc/machines.ini roster: host => raw tag string. Mirrors the
// pf-roster parse (same token grammar) so the deploy chain and this CLI share
// one reading of the roster.
//
// @return array<string,string>
function prod_roster(string $path): array
{
    if (!is_file($path)) {
        return [];
    }
    $cnf = parse_ini_file($path, false, INI_SCANNER_RAW);
    if ($cnf === false) {
        return [];
    }
    $out = [];
    foreach ($cnf as $host => $value) {
        $host = (string) $host;
        if ($host === '' || $host[0] === '#') {
            continue;
        }
        $out[$host] = is_string($value) ? trim($value) : '';
    }
    return $out;
}

// @return array<int,string> trimmed tokens, empties dropped
function tokens(string $raw): array
{
    $out = [];
    foreach (explode(',', $raw) as $rawTok) {
        $tok = trim($rawTok);
        if ($tok !== '') {
            $out[] = $tok;
        }
    }
    return $out;
}

// All member ZeroTier IPs across etc/team.ini (the `member` source). team.ini
// maps member -> (password + hostname -> IP); the IPs are the source hosts.
//
// @return array<int,string>
function team_ips(array $team): array
{
    $ips = [];
    foreach ($team as $entries) {
        if (!is_array($entries)) {
            continue;
        }
        foreach ($entries as $key => $value) {
            if ($key === 'subject' || $key === 'password' || !is_string($value) || $value === '') {
                continue;
            }
            $ips[] = $value;
        }
    }
    return array_values(array_unique($ips));
}

// Resolve a source to its host set: `member` -> team.ini IPs, otherwise a
// machines.ini tag (bare tag or db:<name>) matched exactly.
//
// @param array<int,string> $teamIps
// @param array<string,string> $roster
// @return array<int,string>
function resolve_source_hosts(string $source, array $teamIps, array $roster): array
{
    if ($source === 'member') {
        return $teamIps;
    }
    $hosts = [];
    foreach ($roster as $host => $raw) {
        if (in_array($source, tokens($raw), true)) {
            $hosts[] = $host;
        }
    }
    return $hosts;
}

function sql_quote(string $value): string
{
    return str_replace("'", "''", $value);
}

// Compute the desired state from the declaration. Returns null on a config
// error (message already written to stderr).
//
// @param array{sources: array<string,string>, accounts: array<string,array<int,string>>, allowlist: array<int,string>, require: ?string} $declaration
// @param array<string,mixed> $team
// @param array<string,string> $roster
// @return array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, require: ?string, roleDefsSql: string}|null
function compute_plan(string $dbname, string $sharedDir, string $grantsDir, array $declaration, array $team, array $roster): ?array
{
    $sources = $declaration['sources'];
    $accounts = $declaration['accounts'];
    $allowlist = $declaration['allowlist'];
    $require = $declaration['require'] ?? null;

    $teamIps = team_ips($team);
    $sharedSql = read_upgrade_sql($sharedDir);
    $grantsSql = read_upgrade_sql($grantsDir);

    // Roles declared by the shared package (CREATE ROLE) plus any role a
    // source maps to. This is the cleanup namespace.
    $declaredRoles = array_values(array_unique(array_merge(
        extract_roles($sharedSql),
        array_values($sources)
    )));

    // Roles that hold a GRANT on this database (the per-db grants package).
    $dbRoles = extract_grantee_roles($grantsSql);

    // Desired role set per account per host: the union of the roles for the
    // host's sources, intersected with the roles granted on this database.
    // account => host => [role, ...]
    $wantedRoles = [];
    foreach ($accounts as $account => $sourceList) {
        $wantedRoles[$account] = [];

        // account => host => role => true, across all of the account's sources
        $assignments = [];
        foreach ($sourceList as $source) {
            if (!array_key_exists($source, $sources)) {
                fwrite(STDERR, "gen-service-accounts: account '{$account}' references unknown source '{$source}' (not in sources)\n");
                return null;
            }
            $role = $sources[$source];
            foreach (resolve_source_hosts($source, $teamIps, $roster) as $host) {
                $assignments[$host][$role] = true;
            }
        }

        foreach ($assignments as $host => $roles) {
            $wanted = [];
            foreach (array_keys($roles) as $role) {
                if (in_array($role, $dbRoles, true)) {
                    $wanted[] = $role;
                }
            }
            sort($wanted);
            $wantedRoles[$account][$host] = $wanted;
        }
    }

    // Role definitions (shared CREATE ROLE, then per-db grants), {{dbname}}
    // filled from the schema the instance serves (a replica's dbname is the
    // primary's schema, distinct from its instance name).
    $roleDefsSql = $sharedSql . PHP_EOL . $grantsSql . PHP_EOL;
    $roleDefsSql = str_replace('{{dbname}}', $dbname, $roleDefsSql);

    return [
        'db' => $dbname,
        'accounts' => array_keys($accounts),
        'declaredRoles' => $declaredRoles,
        'wantedRoles' => $wantedRoles,
        'allowlist' => $allowlist,
        'require' => $require,
        'roleDefsSql' => $roleDefsSql,
    ];
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, require: ?string, roleDefsSql: string} $plan
function build_setup_sql(array $plan): string
{
    $sql = '-- gen-service-accounts reconcile for `' . $plan['db'] . '` (transient; never persisted)' . PHP_EOL;
    $sql .= PHP_EOL . '-- Phase 1 — role definitions + per-database grants' . PHP_EOL;
    $sql .= $plan['roleDefsSql'];
    $require = $plan['require'] ?? null;
    $req = ($require !== null && $require !== '') ? ' REQUIRE ' . $require : '';
    $sql .= PHP_EOL . '-- Phase 2 — service accounts (passwordless, host-pinned' . ($req !== '' ? ', ' . $require . '-required' : '') . ')' . PHP_EOL;

    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $roles = $plan['wantedRoles'][$account][$host];
            if (count($roles) === 0) {
                continue; // holds no role on this database; dropped by Phase 4
            }
            $a = sql_quote($account);
            $h = sql_quote($host);
            $sql .= "CREATE USER IF NOT EXISTS '{$a}'@'{$h}' IDENTIFIED BY ''{$req};" . PHP_EOL;
            $sql .= "ALTER USER '{$a}'@'{$h}' IDENTIFIED BY ''{$req};" . PHP_EOL;
            foreach ($roles as $role) {
                $sql .= 'GRANT ' . $role . " TO '{$a}'@'{$h}';" . PHP_EOL;
            }
            $sql .= 'SET DEFAULT ROLE ' . implode(', ', $roles) . " FOR '{$a}'@'{$h}';" . PHP_EOL;
        }
    }

    return $sql;
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, require: ?string, roleDefsSql: string} $plan
// @param array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>, dbGrants: array<string,bool>} $live
function build_revoke_sql(array $plan, array $live): string
{
    $sql = '-- Phase 3 — revoke (excess roles, then direct grants)' . PHP_EOL;

    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $roles = $plan['wantedRoles'][$account][$host];
            if (count($roles) === 0) {
                continue; // unwanted host; dropped by Phase 4, nothing to revoke
            }
            $key = $account . '@' . $host;
            if (!isset($live['accounts'][$key])) {
                continue; // account@host not present; nothing to revoke
            }
            $a = sql_quote($account);
            $h = sql_quote($host);
            foreach ($live['roleGrants'][$key] ?? [] as $role) {
                if (!in_array($role, $roles, true)) {
                    $sql .= 'REVOKE ' . $role . " FROM '{$a}'@'{$h}';" . PHP_EOL;
                }
            }
            // Only an account holding a db-level grant can be revoked: both
            // statements below fail with ERROR 1141 otherwise, and a role-only
            // account (the common case, and every account on a re-run) holds
            // none.
            if (!isset($live['dbGrants'][$key])) {
                continue;
            }
            // Two statements: `ALL PRIVILEGES, GRANT OPTION` in one is not
            // valid MariaDB syntax (ERROR 1064), and `ALL PRIVILEGES` on its
            // own leaves the grant option behind.
            $sql .= 'REVOKE GRANT OPTION ON ' . $plan['db'] . ".* FROM '{$a}'@'{$h}';" . PHP_EOL;
            $sql .= 'REVOKE ALL PRIVILEGES ON ' . $plan['db'] . ".* FROM '{$a}'@'{$h}';" . PHP_EOL;
        }
    }

    return $sql;
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, require: ?string, roleDefsSql: string} $plan
// @param array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>, dbGrants: array<string,bool>} $live
function build_drop_sql(array $plan, array $live): string
{
    $sql = '-- Phase 4 — drop (undeclared/unwanted accounts, undeclared roles)' . PHP_EOL;

    $declaredAccounts = array_flip($plan['accounts']);
    $allowlist = array_flip($plan['allowlist']);

    // 1. Undeclared accounts: present in mysql.user, not declared, not
    //    allow-listed. Instance-wide (accounts are global in mysql.user).
    foreach (array_keys($live['accounts']) as $key) {
        $at = strpos($key, '@');
        if ($at === false) {
            continue;
        }
        $user = substr($key, 0, $at);
        $host = substr($key, $at + 1);
        if (isset($declaredAccounts[$user]) || isset($allowlist[$user])) {
            continue;
        }
        $sql .= 'DROP USER IF EXISTS ' . "'" . sql_quote($user) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
    }

    // 2. Declared account hosts that hold no role on this database (a
    //    role without a GRANT here means the account is not wanted here).
    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            if (count($plan['wantedRoles'][$account][$host]) > 0) {
                continue;
            }
            $sql .= 'DROP USER IF EXISTS ' . "'" . sql_quote($account) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
        }
    }

    // 3. Undeclared roles in the consumer's namespace: still granted to a
    //    declared account but no longer in the declaration.
    $orphaned = [];
    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $key = $account . '@' . $host;
            foreach ($live['roleGrants'][$key] ?? [] as $role) {
                if (!in_array($role, $plan['declaredRoles'], true)) {
                    $orphaned[$role] = true;
                }
            }
        }
    }
    foreach (array_keys($orphaned) as $role) {
        $sql .= 'DROP ROLE IF EXISTS ' . $role . ';' . PHP_EOL;
    }

    return $sql;
}

// The two host paths the transport needs, from the consumer's etc/deploy.conf:
// the deployed repo root (DEPLOY_TARGET_DIR) and the nix result parent
// (DEPLOY_NIX_RESULT_DIR), whose result/bin carries the host's php. The file is
// sourced as a plain file — the same loading contract as the framework's other
// CLIs (deploy, tmux-remote, cron-manifest) — so no shell parsing is
// re-implemented here. Null (message written) when the file or either value is
// missing.
//
// @return array{dir: string, nix: string}|null
function deploy_conf_paths(string $root): ?array
{
    $conf = $root . '/etc/deploy.conf';
    if (!is_file($conf)) {
        fwrite(STDERR, "gen-service-accounts: {$conf} not found — it holds the host's deployed repo root and nix result parent (see doc/system/consumer-config.md)\n");
        return null;
    }
    $script = "set -a; . \"\$1\"; set +a; printf '%s\n' \"\${DEPLOY_TARGET_DIR:-}\" \"\${DEPLOY_NIX_RESULT_DIR:-}\"";
    $out = [];
    $code = 0;
    exec('bash -c ' . escapeshellarg($script) . ' bash ' . escapeshellarg($conf), $out, $code);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: could not read {$conf} (exit {$code})\n");
        return null;
    }
    $dir = trim($out[0] ?? '');
    $nix = trim($out[1] ?? '');
    if ($dir === '') {
        fwrite(STDERR, "gen-service-accounts: {$conf} sets no DEPLOY_TARGET_DIR\n");
        return null;
    }
    if ($nix === '') {
        fwrite(STDERR, "gen-service-accounts: {$conf} sets no DEPLOY_NIX_RESULT_DIR — the host's php lives in its result/bin (see doc/system/deploy.md)\n");
        return null;
    }
    return ['dir' => $dir, 'nix' => $nix];
}

// The `ema mariadb <db>` invocation a SQL-carrying command runs through.
// Locally (on the database host) it is the consumer's ema — or the one on PATH
// — run from the repo root. On the operator machine it is the same ema on the
// database host, as root over ssh, from the deployed repo root, so the host's
// shipped etc/reuter.ini and the instance's own socket are the ones resolved.
//
// The remote invocation also carries the PATH a host's CLIs expect — the
// deployed repo's vendor/bin plus the nix result bin (same pair as tmux-remote
// and pf-server-steps.sh): a host has no php on PATH, the deploy delivers it as
// the nix result, and ema's wrapper calls a bare `php`.
//
// $args is a shell-quoted argument fragment ('-N -e <sql>'), appended to the
// invocation on whichever side it runs. A shell redirection is not: the caller
// appends that outside, so it stays local (stdin to ssh) instead of resolving
// against a path that exists only here.
//
// @param array{host: ?string, dir: ?string, nix: ?string} $transport null host = run locally
function ema_command(string $root, string $db, array $transport, string $args = ''): string
{
    $tail = $args === '' ? '' : ' ' . $args;
    if ($transport['host'] === null) {
        $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
        return 'EMA_TARGET=prod ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db) . $tail;
    }
    $remote = 'cd ' . escapeshellarg((string) $transport['dir']) . ' || exit 1' . "\n"
        . 'export PATH="$PWD/vendor/bin":' . escapeshellarg((string) $transport['nix'] . '/result/bin') . ':"$PATH"' . "\n"
        . 'EMA_TARGET=prod ./vendor/bin/ema mariadb ' . escapeshellarg($db) . $tail;
    return 'ssh ' . escapeshellarg('root@' . $transport['host']) . ' ' . escapeshellarg($remote);
}

// @param array{host: ?string, dir: ?string, nix: ?string} $transport
// @return array<int,string>|null one line per output row, or null on failure
function run_query(string $root, string $db, array $transport, string $sql): ?array
{
    $cmd = ema_command($root, $db, $transport, '-N -e ' . escapeshellarg($sql));
    $output = [];
    $code = 0;
    // stderr stays connected: a transport or auth failure must surface the
    // client's own error, not just this function's null.
    exec($cmd, $output, $code);
    if ($code !== 0) {
        return null;
    }
    return $output;
}

// @param array{host: ?string, dir: ?string, nix: ?string} $transport
// @return array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>, dbGrants: array<string,bool>}|null
function query_live_state(string $root, string $db, string $dbname, array $transport): ?array
{
    $accountLines = run_query($root, $db, $transport, "SELECT User, Host FROM mysql.user WHERE Host <> ''");
    if ($accountLines === null) {
        return null;
    }
    $grantLines = run_query($root, $db, $transport, 'SELECT User, Host, Role FROM mysql.roles_mapping');
    if ($grantLines === null) {
        return null;
    }
    // Direct db-level grants on the managed schema (mysql.db is keyed by the
    // schema, not the instance): Phase 3 revokes them, and only an account
    // listed here has any to revoke (the revoke statements fail with ERROR
    // 1141 on an account that holds none).
    $dbGrantLines = run_query($root, $db, $transport, "SELECT User, Host FROM mysql.db WHERE Db = '" . sql_quote($dbname) . "'");
    if ($dbGrantLines === null) {
        return null;
    }

    $accounts = [];
    foreach ($accountLines as $line) {
        $parts = explode("\t", $line);
        if (count($parts) >= 2) {
            $accounts[$parts[0] . '@' . $parts[1]] = true;
        }
    }

    $roleGrants = [];
    foreach ($grantLines as $line) {
        $parts = explode("\t", $line);
        if (count($parts) >= 3) {
            $roleGrants[$parts[0] . '@' . $parts[1]][] = $parts[2];
        }
    }

    $dbGrants = [];
    foreach ($dbGrantLines as $line) {
        $parts = explode("\t", $line);
        if (count($parts) >= 2) {
            $dbGrants[$parts[0] . '@' . $parts[1]] = true;
        }
    }

    return ['accounts' => $accounts, 'roleGrants' => $roleGrants, 'dbGrants' => $dbGrants];
}

// @param array{host: ?string, dir: ?string, nix: ?string} $transport
function apply_sql(string $root, string $db, array $transport, string $sql): int
{
    $tmp = tempnam(sys_get_temp_dir(), 'gen_service_accounts_');
    if ($tmp === false || file_put_contents($tmp, $sql) === false) {
        fwrite(STDERR, "gen-service-accounts: could not write the temporary SQL file\n");
        return 1;
    }
    // The redirect stays local: over ssh it feeds the remote command's stdin.
    $cmd = ema_command($root, $db, $transport) . ' < ' . escapeshellarg($tmp);
    passthru($cmd, $code);
    @unlink($tmp);
    return $code;
}

function main(array $argv): int
{
    $root = getcwd();
    if ($root === false) {
        $root = '.';
    }

    // default.php files now return Ema\Config\* instances; make the classes
    // resolvable before the first include (Composer autoloader, at the repo
    // root where this CLI runs).
    require $root . '/vendor/autoload.php';

    $db = null;
    $dryRun = false;
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '-n' || $arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, HELP);
            return 0;
        } elseif ($db === null) {
            $db = $arg;
        } else {
            fwrite(STDERR, "gen-service-accounts: unexpected argument: {$arg}\n");
            return 1;
        }
    }
    if ($db === null) {
        fwrite(STDERR, "gen-service-accounts: missing <db> argument\n");
        fwrite(STDERR, HELP);
        return 1;
    }

    // The schema the instance serves (the package's dbname), distinct from the
    // instance name `$db` (which keys the grants package, the db:<name> roster
    // token and the ema section).
    $dbname = srv_dbname($root, $db);

    // etc/team.ini (the `member` source). Absent -> no member hosts.
    $teamIni = $root . '/etc/team.ini';
    $team = [];
    if (is_file($teamIni)) {
        $parsed = parse_ini_file($teamIni, true, INI_SCANNER_RAW);
        $team = is_array($parsed) ? $parsed : [];
    }

    // etc/machines.ini (tag sources).
    $roster = prod_roster($root . '/etc/machines.ini');

    // The instance's host: the `db:<name>` roster token names it (the
    // framework's one-to-one server mapping). Absent -> the DB host itself,
    // which carries no roster: run locally, as an on-host run does.
    $dbHosts = resolve_source_hosts('db:' . $db, [], $roster);
    if (count($dbHosts) > 1) {
        fwrite(STDERR, "gen-service-accounts: db:{$db} is tagged on more than one host (" . implode(', ', $dbHosts) . "); keep one\n");
        return 1;
    }
    $transport = ['host' => $dbHosts[0] ?? null, 'dir' => null, 'nix' => null];
    if ($transport['host'] !== null) {
        // Resolve the host's paths up front: every query and the apply run
        // through them, so a missing etc/deploy.conf must fail before the first
        // connection.
        $paths = deploy_conf_paths($root);
        if ($paths === null) {
            return 1;
        }
        $transport['dir'] = $paths['dir'];
        $transport['nix'] = $paths['nix'];
    }

    $grantsDir = find_grants_package($root, $db);
    if ($grantsDir === null) {
        return 1;
    }
    $sharedDir = find_shared_roles_package($root, $grantsDir);
    if ($sharedDir === null) {
        fwrite(STDERR, "gen-service-accounts: no shared pkg/roles-<GUID> dependency in pkg/{$db}.roles-<GUID>\n");
        return 1;
    }

    $declaration = package_declaration($sharedDir);
    if (count($declaration['accounts']) === 0) {
        fwrite(STDERR, "gen-service-accounts: no accounts declared in pkg/roles-<GUID>/default.php (nothing to reconcile)\n");
        return 1;
    }

    $plan = compute_plan($dbname, $sharedDir, $grantsDir, $declaration, $team, $roster);
    if ($plan === null) {
        return 1;
    }

    // Live account/role state drives the closed-world revoke/drop set.
    $live = query_live_state($root, $db, $dbname, $transport);
    if ($live === null) {
        if (!$dryRun) {
            $where = $transport['host'] === null ? 'on this host' : 'on ' . $transport['host'];
            fwrite(STDERR, "gen-service-accounts: could not read live account/role state for '{$db}' {$where} (see the client error above)\n");
            return 1;
        }
        fwrite(STDERR, "gen-service-accounts: warning: live state unavailable; closed-world revoke/drop set omitted (dry-run)\n");
        $live = ['accounts' => [], 'roleGrants' => [], 'dbGrants' => []];
    }

    $setupSql = build_setup_sql($plan);
    $revokeSql = build_revoke_sql($plan, $live);
    $dropSql = build_drop_sql($plan, $live);

    fwrite(STDOUT, $setupSql . PHP_EOL . $revokeSql . PHP_EOL . $dropSql);

    if ($dryRun) {
        fwrite(STDERR, "gen-service-accounts: dry-run; SQL printed, not applied\n");
        return 0;
    }

    // Phase 1+2: create/grant. A failure aborts (host left with a superset).
    $code = apply_sql($root, $db, $transport, $setupSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: setup SQL failed (exit {$code}); aborting\n");
        return 1;
    }

    // Phase 3: revoke. Retry once on failure, then abort and report.
    $code = apply_sql($root, $db, $transport, $revokeSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: revoke SQL failed (exit {$code}); retrying once\n");
        $code = apply_sql($root, $db, $transport, $revokeSql);
        if ($code !== 0) {
            fwrite(STDERR, "gen-service-accounts: revoke SQL failed again (exit {$code}); aborting\n");
            fwrite(STDERR, "failed SQL:\n" . $revokeSql);
            return 1;
        }
    }

    // Phase 4: drop.
    $code = apply_sql($root, $db, $transport, $dropSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: drop SQL failed (exit {$code}); aborting\n");
        fwrite(STDERR, "failed SQL:\n" . $dropSql);
        return 1;
    }

    return 0;
}

exit(main($argv));
