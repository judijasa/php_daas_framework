#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-service-accounts — reconcile passwordless, host-pinned service accounts
// and roles from the shared srv/roles-<GUID> declaration ($sources/$accounts),
// etc/team.ini (the `member` source), etc/machines.ini (tag sources) and the
// srv/<db>.roles-<GUID> per-database grant package. The framework owns the
// mechanism (declaration format + reconcile); the consumer owns the data (its
// role definitions, per-database grants, account/source mapping, team roster,
// host registry, allow-list and role namespace) and the account model — one
// shared account pinned to many sources, several accounts with disjoint
// sources, or anything in between. No account name, role name, grant or
// source is hardcoded here.
//
// Reconcile is closed-world on role *memberships* (not GRANT privileges): the
// desired state per account per host is the union of the roles for that
// host's sources; excess roles are revoked and undeclared accounts/roles are
// dropped. See doc/system/service-accounts.md for the full contract.
//
// Emits transient SQL (never persisted) and, unless -n/--dry-run, applies it
// as root through `ema mariadb <db> < file.sql`. ema owns the connection:
// it connects as root for sandboxes and as DBUSER for prod, so this CLI runs
// `ema mariadb` with DBUSER=root to provision as root. Run it as root on the
// DB host (root/unix_socket auth over the MYSQL_UNIX_PORT socket from the
// manual reuter.ini section).
//
// Apply order is fail-open: roles + grants, then accounts + role grants, then
// revoke (excess roles, then direct grants), then drop. A partial failure
// leaves a host holding a superset (never locked out); re-running converges.
//
// Usage: gen-service-accounts <db> [-n|--dry-run] [-h|--help]

const HELP = <<<'TXT'
Usage: gen-service-accounts <db> [flags]

Reconcile passwordless, host-pinned service accounts and roles for one
database, from the shared srv/roles-<GUID> declaration ($sources/$accounts),
etc/team.ini + etc/machines.ini, and srv/<db>.roles-<GUID>.

  <db>              database name (resolves srv/<db>.roles-<GUID>).
  -n, --dry-run     print the reconcile SQL without applying it.
  -h, --help        show this help.

The shared srv/roles-<GUID>/default.php declares $sources (source -> role),
$accounts (account -> sources) and, optionally, $allowlist (accounts never
dropped). A source is `member` (team.ini IPs) or a machines.ini tag.
TXT;

function srv_package_dir(string $root, string $name): ?string
{
    $dir = $root . '/srv/' . $name;
    return is_dir($dir) ? $dir : null;
}

function find_grants_package(string $root, string $db): ?string
{
    $matches = glob($root . '/srv/' . $db . '.roles-*') ?: [];
    $matches = array_values(array_filter($matches, 'is_dir'));
    if (count($matches) === 1) {
        return $matches[0];
    }
    if (count($matches) === 0) {
        fwrite(STDERR, "gen-service-accounts: no srv/{$db}.roles-<GUID> package found\n");
    } else {
        fwrite(STDERR, "gen-service-accounts: multiple srv/{$db}.roles-<GUID> packages found; keep one\n");
    }
    return null;
}

// The shared roles package is the grants package's `roles-<GUID>` dependency.
function find_shared_roles_package(string $root, string $grantsDir): ?string
{
    foreach (package_dependencies($grantsDir) as $dep) {
        if (strpos($dep, 'roles-') === 0) {
            $dir = srv_package_dir($root, $dep);
            if ($dir !== null) {
                return $dir;
            }
        }
    }
    return null;
}

// Include a package's default.php and return the variables it defined. The
// data file assigns local variables ($dependencies, and optionally
// $sources/$accounts/$allowlist); including it inside this function scopes
// those assignments here, and get_defined_vars() reads them back (PHPStan
// cannot see through a dynamic include, so the read stays generic).
//
// @return array<string,mixed>
function package_vars(string $dir): array
{
    $default = $dir . '/default.php';
    $vars = [];
    if (is_file($default)) {
        include $default;
        $vars = get_defined_vars();
    }
    return $vars;
}

function package_dependencies(string $dir): array
{
    $dependencies = package_vars($dir)['dependencies'] ?? null;
    return is_array($dependencies) ? array_values($dependencies) : [];
}

// Load the shared roles package's optional declaration. Absent keys fall back
// to the gen-grants shape (no service accounts). Values are validated/coerced
// so the result is a clean typed shape regardless of what default.php sets.
//
// @return array{sources: array<string,string>, accounts: array<string,array<int,string>>, allowlist: array<int,string>}
function package_declaration(string $dir): array
{
    $vars = package_vars($dir);
    $sources = $vars['sources'] ?? null;
    $accounts = $vars['accounts'] ?? null;
    $allowlist = $vars['allowlist'] ?? null;

    $src = [];
    if (is_array($sources)) {
        foreach ($sources as $k => $v) {
            if (is_string($v)) {
                $src[(string) $k] = $v;
            }
        }
    }

    $acct = [];
    if (is_array($accounts)) {
        foreach ($accounts as $k => $v) {
            if (is_array($v)) {
                $list = [];
                foreach ($v as $item) {
                    if (is_string($item)) {
                        $list[] = $item;
                    }
                }
                $acct[(string) $k] = $list;
            }
        }
    }

    // root/mariadb.sys form an always-on safety floor: the closed-world drop
    // must never remove the instance's own engine-internal accounts. Accounts
    // the consumer creates itself (e.g. `replication` via replica-bootstrap)
    // are not covered here — declare them in $allowlist, which extends
    // (never replaces) this floor.
    $allow = ['root', 'mariadb.sys'];
    if (is_array($allowlist)) {
        foreach ($allowlist as $item) {
            if (is_string($item)) {
                $allow[] = $item;
            }
        }
    }
    $allow = array_values(array_unique($allow));

    return ['sources' => $src, 'accounts' => $acct, 'allowlist' => $allow];
}

function read_upgrade_sql(string $dir): string
{
    $sql = is_file($dir . '/upgrade.sql') ? file_get_contents($dir . '/upgrade.sql') : '';
    return $sql === false ? '' : $sql;
}

// Extract role names from CREATE ROLE [IF NOT EXISTS] <name> statements.
function extract_roles(string $sql): array
{
    if (preg_match_all('/\bCREATE\s+ROLE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z0-9_]+)/i', $sql, $m) === false) {
        return [];
    }
    return array_values(array_unique($m[1]));
}

// Extract role names that hold a GRANT on this database, from the per-database
// grants package: GRANT <priv> ON {{dbname}}.* TO <role>.
function extract_grantee_roles(string $sql): array
{
    if (preg_match_all('/\bON\s+\{\{dbname\}\}\.\*\s+TO\s+([A-Za-z0-9_]+)/i', $sql, $m) === false) {
        return [];
    }
    return array_values(array_unique($m[1]));
}

// etc/machines.ini [prod] roster: host => raw tag string. Mirrors the
// pf-roster parse (same token grammar) so the deploy chain and this CLI share
// one reading of the roster.
//
// @return array<string,string>
function prod_roster(string $path): array
{
    if (!is_file($path)) {
        return [];
    }
    $cnf = parse_ini_file($path, true, INI_SCANNER_RAW);
    if ($cnf === false || !isset($cnf['prod']) || !is_array($cnf['prod'])) {
        return [];
    }
    $out = [];
    foreach ($cnf['prod'] as $host => $value) {
        $host = (string) $host;
        if ($host === '' || $host[0] === '#') {
            continue;
        }
        $out[$host] = is_string($value) ? trim($value) : '';
    }
    return $out;
}

// @return array<int,string> trimmed tokens, empties dropped
function tokens(string $raw): array
{
    $out = [];
    foreach (explode(',', $raw) as $rawTok) {
        $tok = trim($rawTok);
        if ($tok !== '') {
            $out[] = $tok;
        }
    }
    return $out;
}

// All member ZeroTier IPs across etc/team.ini (the `member` source). team.ini
// maps member -> (subject + hostname -> IP); the IPs are the source hosts.
//
// @return array<int,string>
function team_ips(array $team): array
{
    $ips = [];
    foreach ($team as $entries) {
        if (!is_array($entries)) {
            continue;
        }
        foreach ($entries as $key => $value) {
            if ($key === 'subject' || !is_string($value) || $value === '') {
                continue;
            }
            $ips[] = $value;
        }
    }
    return array_values(array_unique($ips));
}

// Resolve a source to its host set: `member` -> team.ini IPs, otherwise a
// machines.ini tag (bare tag or db:<name>) matched exactly.
//
// @param array<int,string> $teamIps
// @param array<string,string> $roster
// @return array<int,string>
function resolve_source_hosts(string $source, array $teamIps, array $roster): array
{
    if ($source === 'member') {
        return $teamIps;
    }
    $hosts = [];
    foreach ($roster as $host => $raw) {
        if (in_array($source, tokens($raw), true)) {
            $hosts[] = $host;
        }
    }
    return $hosts;
}

function sql_quote(string $value): string
{
    return str_replace("'", "''", $value);
}

// Compute the desired state from the declaration. Returns null on a config
// error (message already written to stderr).
//
// @param array{sources: array<string,string>, accounts: array<string,array<int,string>>, allowlist: array<int,string>} $declaration
// @param array<string,mixed> $team
// @param array<string,string> $roster
// @return array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, roleDefsSql: string}|null
function compute_plan(string $db, string $sharedDir, string $grantsDir, array $declaration, array $team, array $roster): ?array
{
    $sources = $declaration['sources'];
    $accounts = $declaration['accounts'];
    $allowlist = $declaration['allowlist'];

    $teamIps = team_ips($team);
    $sharedSql = read_upgrade_sql($sharedDir);
    $grantsSql = read_upgrade_sql($grantsDir);

    // Roles declared by the shared package (CREATE ROLE) plus any role a
    // source maps to. This is the cleanup namespace.
    $declaredRoles = array_values(array_unique(array_merge(
        extract_roles($sharedSql),
        array_values($sources)
    )));

    // Roles that hold a GRANT on this database (the per-db grants package).
    $dbRoles = extract_grantee_roles($grantsSql);

    // Desired role set per account per host: the union of the roles for the
    // host's sources, intersected with the roles granted on this database.
    // account => host => [role, ...]
    $wantedRoles = [];
    foreach ($accounts as $account => $sourceList) {
        $wantedRoles[$account] = [];

        // account => host => role => true, across all of the account's sources
        $assignments = [];
        foreach ($sourceList as $source) {
            if (!array_key_exists($source, $sources)) {
                fwrite(STDERR, "gen-service-accounts: account '{$account}' references unknown source '{$source}' (not in \$sources)\n");
                return null;
            }
            $role = $sources[$source];
            foreach (resolve_source_hosts($source, $teamIps, $roster) as $host) {
                $assignments[$host][$role] = true;
            }
        }

        foreach ($assignments as $host => $roles) {
            $wanted = [];
            foreach (array_keys($roles) as $role) {
                if (in_array($role, $dbRoles, true)) {
                    $wanted[] = $role;
                }
            }
            sort($wanted);
            $wantedRoles[$account][$host] = $wanted;
        }
    }

    // Role definitions (shared CREATE ROLE, then per-db grants), {{dbname}}
    // filled from the target database.
    $roleDefsSql = $sharedSql . PHP_EOL . $grantsSql . PHP_EOL;
    $roleDefsSql = str_replace('{{dbname}}', $db, $roleDefsSql);

    return [
        'db' => $db,
        'accounts' => array_keys($accounts),
        'declaredRoles' => $declaredRoles,
        'wantedRoles' => $wantedRoles,
        'allowlist' => $allowlist,
        'roleDefsSql' => $roleDefsSql,
    ];
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, roleDefsSql: string} $plan
function build_setup_sql(array $plan): string
{
    $sql = '-- gen-service-accounts reconcile for `' . $plan['db'] . '` (transient; never persisted)' . PHP_EOL;
    $sql .= PHP_EOL . '-- Phase 1 — role definitions + per-database grants' . PHP_EOL;
    $sql .= $plan['roleDefsSql'];
    $sql .= PHP_EOL . '-- Phase 2 — service accounts (passwordless, host-pinned)' . PHP_EOL;

    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $roles = $plan['wantedRoles'][$account][$host];
            if (count($roles) === 0) {
                continue; // holds no role on this database; dropped by Phase 4
            }
            $a = sql_quote($account);
            $h = sql_quote($host);
            $sql .= "CREATE USER IF NOT EXISTS '{$a}'@'{$h}' IDENTIFIED BY '';" . PHP_EOL;
            $sql .= "ALTER USER '{$a}'@'{$h}' IDENTIFIED BY '';" . PHP_EOL;
            foreach ($roles as $role) {
                $sql .= 'GRANT ' . $role . " TO '{$a}'@'{$h}';" . PHP_EOL;
            }
            $sql .= 'SET DEFAULT ROLE ' . implode(', ', $roles) . " FOR '{$a}'@'{$h}';" . PHP_EOL;
        }
    }

    return $sql;
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, roleDefsSql: string} $plan
// @param array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>} $live
function build_revoke_sql(array $plan, array $live): string
{
    $sql = '-- Phase 3 — revoke (excess roles, then direct grants)' . PHP_EOL;

    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $roles = $plan['wantedRoles'][$account][$host];
            if (count($roles) === 0) {
                continue; // unwanted host; dropped by Phase 4, nothing to revoke
            }
            $key = $account . '@' . $host;
            if (!isset($live['accounts'][$key])) {
                continue; // account@host not present; nothing to revoke
            }
            $a = sql_quote($account);
            $h = sql_quote($host);
            foreach ($live['roleGrants'][$key] ?? [] as $role) {
                if (!in_array($role, $roles, true)) {
                    $sql .= 'REVOKE ' . $role . " FROM '{$a}'@'{$h}';" . PHP_EOL;
                }
            }
            $sql .= 'REVOKE ALL PRIVILEGES, GRANT OPTION ON ' . $plan['db'] . ".* FROM '{$a}'@'{$h}';" . PHP_EOL;
        }
    }

    return $sql;
}

// @param array{db: string, accounts: array<int,string>, declaredRoles: array<int,string>, wantedRoles: array<string,array<string,array<int,string>>>, allowlist: array<int,string>, roleDefsSql: string} $plan
// @param array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>} $live
function build_drop_sql(array $plan, array $live): string
{
    $sql = '-- Phase 4 — drop (undeclared/unwanted accounts, undeclared roles)' . PHP_EOL;

    $declaredAccounts = array_flip($plan['accounts']);
    $allowlist = array_flip($plan['allowlist']);

    // 1. Undeclared accounts: present in mysql.user, not declared, not
    //    allow-listed. Instance-wide (accounts are global in mysql.user).
    foreach (array_keys($live['accounts']) as $key) {
        $at = strpos($key, '@');
        if ($at === false) {
            continue;
        }
        $user = substr($key, 0, $at);
        $host = substr($key, $at + 1);
        if (isset($declaredAccounts[$user]) || isset($allowlist[$user])) {
            continue;
        }
        $sql .= 'DROP USER IF EXISTS ' . "'" . sql_quote($user) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
    }

    // 2. Declared account hosts that hold no role on this database (a
    //    role without a GRANT here means the account is not wanted here).
    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            if (count($plan['wantedRoles'][$account][$host]) > 0) {
                continue;
            }
            $sql .= 'DROP USER IF EXISTS ' . "'" . sql_quote($account) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
        }
    }

    // 3. Undeclared roles in the consumer's namespace: still granted to a
    //    declared account but no longer in the declaration.
    $orphaned = [];
    foreach ($plan['accounts'] as $account) {
        $hosts = array_keys($plan['wantedRoles'][$account]);
        sort($hosts);
        foreach ($hosts as $host) {
            $key = $account . '@' . $host;
            foreach ($live['roleGrants'][$key] ?? [] as $role) {
                if (!in_array($role, $plan['declaredRoles'], true)) {
                    $orphaned[$role] = true;
                }
            }
        }
    }
    foreach (array_keys($orphaned) as $role) {
        $sql .= 'DROP ROLE IF EXISTS ' . $role . ';' . PHP_EOL;
    }

    return $sql;
}

// @return array<int,string>|null one line per output row, or null on failure
function run_query(string $ema, string $db, string $sql): ?array
{
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db) . ' -N -e ' . escapeshellarg($sql);
    $output = [];
    $code = 0;
    exec($cmd . ' 2>/dev/null', $output, $code);
    if ($code !== 0) {
        return null;
    }
    return $output;
}

// @return array{accounts: array<string,bool>, roleGrants: array<string,array<int,string>>}|null
function query_live_state(string $root, string $db): ?array
{
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';

    $accountLines = run_query($ema, $db, "SELECT User, Host FROM mysql.user WHERE Host <> ''");
    if ($accountLines === null) {
        return null;
    }
    $grantLines = run_query($ema, $db, 'SELECT User, Host, Role FROM mysql.roles_mapping');
    if ($grantLines === null) {
        return null;
    }

    $accounts = [];
    foreach ($accountLines as $line) {
        $parts = explode("\t", $line);
        if (count($parts) >= 2) {
            $accounts[$parts[0] . '@' . $parts[1]] = true;
        }
    }

    $roleGrants = [];
    foreach ($grantLines as $line) {
        $parts = explode("\t", $line);
        if (count($parts) >= 3) {
            $roleGrants[$parts[0] . '@' . $parts[1]][] = $parts[2];
        }
    }

    return ['accounts' => $accounts, 'roleGrants' => $roleGrants];
}

function apply_sql(string $root, string $db, string $sql): int
{
    $tmp = tempnam(sys_get_temp_dir(), 'gen_service_accounts_');
    if ($tmp === false || file_put_contents($tmp, $sql) === false) {
        fwrite(STDERR, "gen-service-accounts: could not write the temporary SQL file\n");
        return 1;
    }
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db) . ' < ' . escapeshellarg($tmp);
    passthru($cmd, $code);
    @unlink($tmp);
    return $code;
}

function main(array $argv): int
{
    $root = getcwd();
    if ($root === false) {
        $root = '.';
    }

    $db = null;
    $dryRun = false;
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '-n' || $arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, HELP);
            return 0;
        } elseif ($db === null) {
            $db = $arg;
        } else {
            fwrite(STDERR, "gen-service-accounts: unexpected argument: {$arg}\n");
            return 1;
        }
    }
    if ($db === null) {
        fwrite(STDERR, "gen-service-accounts: missing <db> argument\n");
        fwrite(STDERR, HELP);
        return 1;
    }

    // etc/team.ini (the `member` source). Absent -> no member hosts.
    $teamIni = $root . '/etc/team.ini';
    $team = [];
    if (is_file($teamIni)) {
        $parsed = parse_ini_file($teamIni, true, INI_SCANNER_RAW);
        $team = is_array($parsed) ? $parsed : [];
    }

    // etc/machines.ini [prod] (tag sources).
    $roster = prod_roster($root . '/etc/machines.ini');

    $grantsDir = find_grants_package($root, $db);
    if ($grantsDir === null) {
        return 1;
    }
    $sharedDir = find_shared_roles_package($root, $grantsDir);
    if ($sharedDir === null) {
        fwrite(STDERR, "gen-service-accounts: no shared srv/roles-<GUID> dependency in srv/{$db}.roles-<GUID>\n");
        return 1;
    }

    $declaration = package_declaration($sharedDir);
    if (count($declaration['accounts']) === 0) {
        fwrite(STDERR, "gen-service-accounts: no \$accounts declared in srv/roles-<GUID>/default.php (nothing to reconcile)\n");
        return 1;
    }

    $plan = compute_plan($db, $sharedDir, $grantsDir, $declaration, $team, $roster);
    if ($plan === null) {
        return 1;
    }

    // Live account/role state drives the closed-world revoke/drop set.
    $live = query_live_state($root, $db);
    if ($live === null) {
        if (!$dryRun) {
            fwrite(STDERR, "gen-service-accounts: could not read live account/role state (is the database up, and are you running as root on the DB host?)\n");
            return 1;
        }
        fwrite(STDERR, "gen-service-accounts: warning: live state unavailable; closed-world revoke/drop set omitted (dry-run)\n");
        $live = ['accounts' => [], 'roleGrants' => []];
    }

    $setupSql = build_setup_sql($plan);
    $revokeSql = build_revoke_sql($plan, $live);
    $dropSql = build_drop_sql($plan, $live);

    fwrite(STDOUT, $setupSql . PHP_EOL . $revokeSql . PHP_EOL . $dropSql);

    if ($dryRun) {
        fwrite(STDERR, "gen-service-accounts: dry-run; SQL printed, not applied\n");
        return 0;
    }

    // Phase 1+2: create/grant. A failure aborts (host left with a superset).
    $code = apply_sql($root, $db, $setupSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: setup SQL failed (exit {$code}); aborting\n");
        return 1;
    }

    // Phase 3: revoke. Retry once on failure, then abort and report.
    $code = apply_sql($root, $db, $revokeSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: revoke SQL failed (exit {$code}); retrying once\n");
        $code = apply_sql($root, $db, $revokeSql);
        if ($code !== 0) {
            fwrite(STDERR, "gen-service-accounts: revoke SQL failed again (exit {$code}); aborting\n");
            fwrite(STDERR, "failed SQL:\n" . $revokeSql);
            return 1;
        }
    }

    // Phase 4: drop.
    $code = apply_sql($root, $db, $dropSql);
    if ($code !== 0) {
        fwrite(STDERR, "gen-service-accounts: drop SQL failed (exit {$code}); aborting\n");
        fwrite(STDERR, "failed SQL:\n" . $dropSql);
        return 1;
    }

    return 0;
}

exit(main($argv));
