#!/usr/bin/env bash
# gen-env — regenerate the production .env from a committed etc/deploy.conf.
#
# Framework-owned mechanism; the consumer data is the committed
# etc/deploy.conf (export-style lines). gen-env is a small deterministic
# projection of that file into the git-ignored .env:
#
#   REPO_PATH        := DEPLOY_TARGET_DIR
#   REPO_LOG         := DEPLOY_LOG_DIR
#   REUTER_INI       := /etc/<DEPLOY_DB_INSTANCE>/reuter.ini
#   EMA_TARGET       := prod                        (constant)
#
# The .env is deliberately MYSQL_*-free: the
# app layer (Database.php) must stay on TCP, and the `ema` CLI reads the
# socket from the prod reuter.ini section - gen-reuter writes
# MYSQL_UNIX_PORT=$DEPLOY_DB_BASE/mysql.sock into each [<dbname>] section.
#
# Why this exists: the deployed repo directory is replaced on every deploy,
# so the gitignored .env must be regenerated every time — and it MUST be
# complete before cron is installed: cron runs `phprun` from the repo root,
# the nix wrapper sources .env, and if a key is missing the framework
# silently falls back to its defaults (e.g. EMA_TARGET=local -> wrong DB
# section in production). Hence the fail-fast checks below.
#
# Usage: gen-env [target-dir]   (defaults to $PWD)

set -euo pipefail

TARGET_DIR="${1:-$PWD}"
DEPLOY_CONF="$TARGET_DIR/etc/deploy.conf"
ENV_FILE="$TARGET_DIR/.env"

if [[ ! -f "$DEPLOY_CONF" ]]; then
    echo "gen-env: $DEPLOY_CONF not found" >&2
    echo "  Ship the committed production deploy config (etc/deploy.conf) in the consumer repo." >&2
    exit 1
fi

# Load the project-static deploy config (same loading contract as bin/deploy:
# the file is sourced, so the `export` markers are optional).
set -a
# shellcheck disable=SC1090
. "$DEPLOY_CONF"
set +a

# Fail-fast: the projection below hard-requires these keys. A missing key
# would silently fall back to the framework defaults at runtime.
for _v in DEPLOY_TARGET_DIR DEPLOY_LOG_DIR; do
    if [ -z "${!_v:-}" ]; then
        echo "gen-env: required key $_v is missing from $DEPLOY_CONF" >&2
        exit 1
    fi
done

# DEPLOY_DB_INSTANCE names the /etc config dir (and systemd unit); it
# defaults to the basename of DEPLOY_TARGET_DIR (the existing
# etc/deploy.conf contract).
DB_INSTANCE="${DEPLOY_DB_INSTANCE:-$(basename "$DEPLOY_TARGET_DIR")}"

{
    printf '# Production environment (git-ignored, regenerated by gen-env on every deploy).\n'
    printf '# Projection of the committed etc/deploy.conf; do not edit by hand.\n'
    printf 'export REPO_PATH=%s\n' "$DEPLOY_TARGET_DIR"
    printf 'export REPO_LOG=%s\n' "$DEPLOY_LOG_DIR"
    printf 'export REUTER_INI=/etc/%s/reuter.ini\n' "$DB_INSTANCE"
    printf 'export EMA_TARGET=prod\n'
} > "$ENV_FILE"

# Fail-fast guard: every projected key must be present in the written file.
# Catches partial/interrupted writes that would otherwise silently misroute
# prod cron jobs to the framework defaults.
for _k in REPO_PATH REPO_LOG REUTER_INI EMA_TARGET; do
    grep -qE "^export $_k=" "$ENV_FILE" || {
        echo "ERROR: $ENV_FILE is missing required key: $_k" >&2
        exit 1
    }
done

echo "    Wrote $ENV_FILE from $DEPLOY_CONF"
