#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../src/host_resolver.php';

// pf-roster — [prod] roster queries for the deploy toolchain.
//
// Reads etc/machines.ini [prod] from the consumer repo root (the current
// working directory) and answers generic tag queries, so pf-deploy.sh and
// the consumer deploy wrapper share one parse of the `tag[:name]` token
// list. The parse itself is the shared host lookup (src/host_resolver.php),
// which also pairs a host's short name with its ZeroTier IP for bin/pf-host,
// bin/gen-firewall and bin/pf-deploy.sh (see doc/system/host-resolution.md).
//
// [prod] value grammar (comma-separated tokens):
//   bare tag     `web`       -> boolean flag (a deploy step on this host)
//   bare tag     `worker`    -> a bare tag data jobs use as their cron scope
//   named tag    `db:simo`   -> a `db` resource named `simo`
//   empty value              -> code-only host (no tagged step)
//
// `db` is the framework's built-in tag: `db:<name>` names a database and
// enforces the one-to-one server mapping (the instance itself is provisioned
// by `ema create`, and db-check verifies it via the host's own `mariadb@*`
// units — not via this roster). Every tag doubles as a cron scope: a
// #[CronJob] declares `scope: <tag[:name]>` (or `scope: host` to run on
// every host), and `cron-manifest --host-tags <tokens>` emits only jobs whose
// scope matches this host's tokens. `worker` is an ordinary bare tag in that
// matcher — nothing special-cases it. Every other tag is consumer-owned and
// carried through generically.
//
// Usage (from the consumer repo root):
//   pf-roster              print "host=tags" per line (default)
//   pf-roster --list       same as default
//   pf-roster --validate   enforce per-tag uniqueness (named tokens); exit 1
//                          on a violation

function machines_file(): string
{
    return (getcwd() ?: '.') . '/etc/machines.ini';
}

function normalize(string $raw): string
{
    return implode(',', tokens($raw));
}

/** @return int exit code (0 = valid) */
function validate(array $roster): int
{
    $seen = [];
    foreach ($roster as $host => $raw) {
        foreach (tokens($raw) as $tok) {
            $colon = strpos($tok, ':');
            if ($colon === false) {
                continue; // bare flag: no name, no uniqueness constraint
            }
            $name = substr($tok, $colon + 1);
            if ($name === '') {
                continue;
            }
            if (isset($seen[$tok])) {
                fwrite(STDERR, 'pf-roster: tag ' . $tok . ' is listed more than once in etc/machines.ini [prod] (a named tag maps to exactly one server).' . PHP_EOL);
                return 1;
            }
            $seen[$tok] = true;
        }
    }
    return 0;
}

function main(array $argv): int
{
    $mode = $argv[1] ?? '--list';
    $roster = prod_roster(machines_file());

    if ($mode === '--list') {
        foreach ($roster as $host => $raw) {
            echo $host . '=' . normalize($raw) . PHP_EOL;
        }
        return 0;
    }

    if ($mode === '--validate') {
        return validate($roster);
    }

    fwrite(STDERR, "pf-roster: unknown mode '" . $mode . "' (expected --list or --validate)." . PHP_EOL);
    return 2;
}

exit(main($argv));
