#!/usr/bin/env php
<?php

declare(strict_types=1);

// pf-roster — shared [prod] roster parser for the deploy toolchain.
//
// Reads etc/machines.ini [prod] from the consumer repo root (the current
// working directory) and answers generic tag queries, so pf-deploy.sh,
// deploy-private-config and the consumer deploy wrapper share one parse of
// the `tag[:name]` token list.
//
// [prod] value grammar (comma-separated tokens):
//   bare tag     `web`       -> boolean flag (a deploy step on this host)
//   bare tag     `worker`    -> boolean flag (framework built-in: cron install)
//   named tag    `db:simo`   -> a `db` resource named `simo`
//   empty value              -> code-only host (no tagged step)
//
// `db` and `worker` are the framework's built-in tags: `db:<name>` names a
// database and enforces the one-to-one server mapping (the instance itself is
// provisioned by `ema create`, and db-check verifies it via the host's own
// `mariadb@*` units — not via this roster), and bare `worker` installs the
// cron-manifest output (pf-deploy's server steps). Every other tag is
// consumer-owned and carried through generically.
//
// Usage (from the consumer repo root):
//   pf-roster              print "host=tags" per line (default)
//   pf-roster --list       same as default
//   pf-roster --validate   enforce per-tag uniqueness (named tokens); exit 1
//                          on a violation

function machines_file(): string
{
    return (getcwd() ?: '.') . '/etc/machines.ini';
}

/** @return array<string, string> host => raw tag value */
function prod_roster(string $path): array
{
    if (!is_file($path)) {
        return [];
    }
    $cnf = parse_ini_file($path, true, INI_SCANNER_RAW);
    if ($cnf === false || !isset($cnf['prod']) || !is_array($cnf['prod'])) {
        return [];
    }
    $out = [];
    foreach ($cnf['prod'] as $host => $value) {
        $host = (string) $host;
        // PHP's parse_ini_file skips `;` comments only; `#`-prefixed lines
        // (the templates' comment style) would parse as bogus keys - drop them.
        if ($host === '' || $host[0] === '#') {
            continue;
        }
        $out[$host] = is_string($value) ? trim($value) : '';
    }
    return $out;
}

/** @return string[] trimmed tokens, empties dropped */
function tokens(string $raw): array
{
    $out = [];
    foreach (explode(',', $raw) as $rawTok) {
        $tok = trim($rawTok);
        if ($tok !== '') {
            $out[] = $tok;
        }
    }
    return $out;
}

function normalize(string $raw): string
{
    return implode(',', tokens($raw));
}

/** @return int exit code (0 = valid) */
function validate(array $roster): int
{
    $seen = [];
    foreach ($roster as $host => $raw) {
        foreach (tokens($raw) as $tok) {
            $colon = strpos($tok, ':');
            if ($colon === false) {
                continue; // bare flag: no name, no uniqueness constraint
            }
            $name = substr($tok, $colon + 1);
            if ($name === '') {
                continue;
            }
            if (isset($seen[$tok])) {
                fwrite(STDERR, 'pf-roster: tag ' . $tok . ' is listed more than once in etc/machines.ini [prod] (a named tag maps to exactly one server).' . PHP_EOL);
                return 1;
            }
            $seen[$tok] = true;
        }
    }
    return 0;
}

function main(array $argv): int
{
    $mode = $argv[1] ?? '--list';
    $roster = prod_roster(machines_file());

    if ($mode === '--list') {
        foreach ($roster as $host => $raw) {
            echo $host . '=' . normalize($raw) . PHP_EOL;
        }
        return 0;
    }

    if ($mode === '--validate') {
        return validate($roster);
    }

    fwrite(STDERR, "pf-roster: unknown mode '" . $mode . "' (expected --list or --validate)." . PHP_EOL);
    return 2;
}

exit(main($argv));
