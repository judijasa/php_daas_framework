#!/usr/bin/env bash
# tmux-remote — drop into an interactive tmux session on a consumer host,
# preloaded with that consumer's nix-built runtime environment (php, composer,
# mariadb, jq, tmux, plus the consumer's own phprun/ema).
#
# Framework-owned mechanism; the consumer owns the data: its etc/deploy.conf
# (DEPLOY_TARGET_DIR, DEPLOY_NIX_RESULT_DIR) and the ssh aliases its
# gen-ssh-config wrote. The CLI is client-side and dev-only: it runs on the
# operator's machine and hands the session to the host over ssh.
#
# The app prefix is never typed. <app> is `basename "$PWD"` — the repo
# directory you are standing in, the same derivation gen-ssh-config uses — so
# `tmux-remote <host> <session>` resolves the ssh alias `<app>-<host>`. <host>
# is either spelling — the short name or the ZeroTier IP — resolved by the
# shared host lookup (bin/pf-host); the alias itself is keyed by the name. To
# touch another app you open that app's own shell; there is no override flag.
#
# Plain `ssh <app>-<host>` stays the untouched non-nix path: this CLI only adds
# the nix-enabled convenience shell. On the host it runs (reusing only the PATH
# formula from bin/pf-server-steps.sh, not that deploy script):
#
#   cd "$DEPLOY_TARGET_DIR" && source .env \
#     && export PATH="$PWD/vendor/bin:$DEPLOY_NIX_RESULT_DIR/result/bin:$PATH" \
#     && tmux -f "<framework package>/etc/tmux-remote.conf" new-session -A -s <session>
#
# The tmux session name is the explicit <session> (not the host name or the
# app) — one host can hold several named sessions, re-attached by name. The
# remote config — red status bar, prefix C-a — is the framework's own
# etc/tmux-remote.conf, resolved on the host from the package's path relative
# to the repo root (no package name is hardcoded). See doc/system/tmux-remote.md.
#
# Usage: tmux-remote <host> <session>   (run from the repo root)

set -euo pipefail

# A host name becomes an alias component, and a session name becomes the remote
# tmux session name; keep both to what the consumer's `hosts` mapping allows
# (same rule as gen-ssh-config) so they round-trip through ssh and tmux cleanly.
SAFE_RE='^[A-Za-z0-9._-]+$'
MAX_LINKS=16

die() { echo "tmux-remote: ERROR: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: tmux-remote <host> <session>

Open (or re-attach to) an interactive tmux session on a consumer host, with
the consumer's nix-built runtime on PATH. Run from the repo root: <app> is
`basename "$PWD"`, so the ssh alias resolved is <app>-<host> — the alias
gen-ssh-config writes. The remote session is named <session> and configured by
the framework's etc/tmux-remote.conf (red status bar, prefix C-a, so it never
clashes with a local tmux's C-b).

  <host>           a [prod] host: its short name or its ZeroTier IP (both
                   spellings resolve to the same host; see
                   doc/system/host-resolution.md).
  <session>        tmux session name on the host (letters, digits, '.', '_', '-').

Inside the session:
  tmux ls          list every session on the host (attached and detached).
  C-a d            detach — leave the session running; re-attach with
                   `tmux-remote <host> <session>`.
  C-a :kill-session   delete the session (or `exit` every pane).
EOF
}

main() {
    local host="" session=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage; return 0 ;;
            -*)        usage >&2; return 1 ;;
            *)
                if [[ -z "$host" ]]; then
                    host="$1"
                elif [[ -z "$session" ]]; then
                    session="$1"
                else
                    usage >&2
                    return 1
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$host" || -z "$session" ]]; then
        usage >&2
        return 1
    fi
    if ! [[ "$host" =~ $SAFE_RE ]]; then
        die "invalid host name '$host' (allowed: letters, digits, '.', '_', '-')"
    fi
    if ! [[ "$session" =~ $SAFE_RE ]]; then
        die "invalid session name '$session' (allowed: letters, digits, '.', '_', '-')"
    fi

    local app
    app="$(basename "$PWD")"
    if ! [[ "$app" =~ $SAFE_RE ]]; then
        die "the repo directory name '$app' is not usable as an app prefix (allowed: letters, digits, '.', '_', '-')"
    fi

    # The consumer's etc/deploy.conf is private data kept on the deploy machine
    # (never shipped): source it as a plain file — the same loading contract as
    # bin/cron-manifest and bin/pf-deploy.sh — and read the two values this CLI
    # needs.
    local deploy_conf="$PWD/etc/deploy.conf"
    if [[ ! -f "$deploy_conf" ]]; then
        die "$deploy_conf not found — run tmux-remote from the repo root of a consumer whose etc/deploy.conf is in place (see doc/system/consumer-config.md)."
    fi
    set -a
    # shellcheck disable=SC1090
    . "$deploy_conf"
    set +a

    if [[ -z "${DEPLOY_TARGET_DIR:-}" ]]; then
        die "$deploy_conf sets no DEPLOY_TARGET_DIR"
    fi
    if [[ -z "${DEPLOY_NIX_RESULT_DIR:-}" ]]; then
        die "$deploy_conf sets no DEPLOY_NIX_RESULT_DIR"
    fi

    # Locate this package inside the checkout. The host's repo holds it at the
    # same path relative to the repo root as this machine does — `vendor/<pkg>`
    # for a consumer, the repo root itself when this repo deploys itself — so
    # the relative path is all the remote side needs and no package name is
    # hardcoded. $0 is followed one symlink level (composer installs
    # `vendor/bin/<cli>` as a symlink into the package) and the result is kept
    # logical (`cd` + `pwd`, no further resolution), so a path-repository
    # consumer — whose vendor/<vendor>/<pkg> is itself a symlink to another
    # checkout — still resolves to the path the host will have.
    local self="$0" link hops=0
    while [[ -L "$self" ]]; do
        hops=$((hops + 1))
        if (( hops > MAX_LINKS )); then
            die "cannot resolve $0: too many symlink hops (loop?)"
        fi
        link="$(readlink "$self")"
        case "$link" in
            /*) self="$link" ;;
            *)  self="$(dirname "$self")/$link" ;;
        esac
    done

    local pkg_root pkg_rel
    pkg_root="$(cd "$(dirname "$self")/.." && pwd)"
    case "$pkg_root" in
        "$PWD")   pkg_rel="" ;;
        "$PWD"/*) pkg_rel="${pkg_root#"$PWD"/}" ;;
        *) die "cannot place the framework package inside this checkout: $0 resolves to $pkg_root, outside the repo root $PWD — run tmux-remote from the consumer repo root (vendor/bin/tmux-remote)." ;;
    esac

    # Either spelling: the shared host lookup (the package's own bin/pf-host,
    # run from this repo root) turns the short name or the ZeroTier IP into the
    # canonical host, and the alias gen-ssh-config wrote is keyed by the name —
    # `<app>-<name>`. pf-host has already reported why when it fails.
    local host_out
    if ! host_out="$("$pkg_root/bin/pf-host" --name "$host")"; then
        exit 1
    fi
    host="$host_out"
    if ! [[ "$host" =~ $SAFE_RE ]]; then
        die "the resolved host name '$host' is not usable as an ssh alias component (allowed: letters, digits, '.', '_', '-')"
    fi

    local conf_rel='etc/tmux-remote.conf'
    if [[ -n "$pkg_rel" ]]; then
        conf_rel="$pkg_rel/$conf_rel"
    fi
    local remote_conf="$DEPLOY_TARGET_DIR/$conf_rel"
    local alias="$app-$host"

    # Preflight the alias: `ssh -G` prints the config ssh would use, and an
    # alias nothing matches resolves to itself. Failing here beats a cryptic
    # "could not resolve hostname" after the fact.
    local resolved
    if ! resolved="$(ssh -G "$alias" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')"; then
        die "'ssh -G $alias' failed — the local ssh configuration could not be read."
    fi
    if [[ -z "$resolved" || "$resolved" == "$alias" ]]; then
        die "ssh alias '$alias' is not configured on this machine — run gen-ssh-config from this repo root to write ~/.ssh/config.d/$app.conf (see doc/system/ssh-config.md)."
    fi

    # Remote command. $PWD and $PATH expand on the host (after the cd, so $PWD
    # is the deployed repo root); every locally-known path is quoted with
    # printf %q, so a consumer path with spaces survives the round trip.
    local target_q nix_q conf_q session_q remote_cmd
    printf -v target_q '%q' "$DEPLOY_TARGET_DIR"
    printf -v nix_q '%q' "$DEPLOY_NIX_RESULT_DIR"
    printf -v conf_q '%q' "$remote_conf"
    printf -v session_q '%q' "$session"

    printf -v remote_cmd '%s\n' \
        "cd $target_q || exit 1" \
        'set -a; . ./.env; set +a' \
        "export PATH=\$PWD/vendor/bin:$nix_q/result/bin:\$PATH" \
        "conf=$conf_q" \
        'if [ ! -f "$conf" ]; then' \
        '  echo "tmux-remote: $conf is missing on the host — deploy the repo (composer install delivers the framework package) before opening a remote shell." >&2' \
        '  exit 1' \
        'fi' \
        "exec tmux -f \"\$conf\" new-session -A -s $session_q"

    echo "tmux-remote: ssh $alias -> tmux session '$session'" >&2
    # -t: tmux needs a terminal; ssh would only allocate one implicitly.
    ssh -t "$alias" "$remote_cmd"
}

main "$@"
