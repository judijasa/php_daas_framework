#!/usr/bin/env bash

set -euo pipefail

# cron-manifest — generate a crontab from #[CronJob]/#[Agent] attributes.
#
# Scans the consumer repo's src/ for functions decorated with both
# #[CronJob] and #[Agent] and prints a crontab to stdout, ready to be
# installed by pf-deploy (the framework's deploy CLI redirects it into the
# configured CRON_FILE on every prod host, filtered by that host's tags).
#
# Each #[CronJob] declares where it runs via a required `scope` (`host` = run
# on every host, or a `tag[:name]` token matched exactly against the host's
# own tag list).
#
# Configuration comes from the same two surfaces as `deploy` and `phprun`:
#   .env            (repo-root, git-ignored)  REPO_PATH (also used to locate
#                                              src/ and as the cd target).
#   etc/deploy.conf (git-ignored, consumer-owned)
#                                              CRON_USER, CRON_NIX_BIN (or
#                                              DEPLOY_NIX_RESULT_DIR, from
#                                              which the bin dir is derived).
#
# Usage: cron-manifest [--host-tags <comma-list>]   (run from the consumer
#         repo root; --host-tags emits only jobs whose scope is `host` or an
#         exact element of the list — with no flag, all jobs are emitted)

# Load runtime config from a .env in the current working directory (the
# consumer repo root), same contract as bin/phprun.
if [[ -f "$PWD/.env" ]]; then
  set -a
  . "$PWD/.env"
  set +a
fi

# Load the project-static deploy config; CRON_USER/CRON_NIX_BIN live here.
if [[ -f "$PWD/etc/deploy.conf" ]]; then
  set -a
  . "$PWD/etc/deploy.conf"
  set +a
fi

# Locate the PHP script relative to this wrapper's real location, resolving
# nix store and vendor/bin symlinks (same pattern as bin/phprun).
RUNNER="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/src/cron_manifest.php"

php "$RUNNER" "$@"
