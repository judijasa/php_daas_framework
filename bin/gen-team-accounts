#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-team-accounts — reconcile team-member DB accounts + roles from etc/team.ini
// and the pkg/<db>.roles-<GUID> package(s). The framework owns the mechanism
// (format + reconcile); the consumer owns the data (etc/team.ini) and the
// role policy (the pkg/ roles packages).
//
// It emits transient SQL (never persisted) and, unless -n/--dry-run, applies
// it as root through `ema mdb <db> < file.sql`. ema owns the connection:
// it connects as root for sandboxes and as DBUSER for prod, so gen-team-accounts
// runs `ema mdb` with DBUSER=root to make the reconcile provision as
// root. Run it as root on the DB host (root/unix_socket auth over the
// MYSQL_UNIX_PORT socket from the manual reuter.ini section).
//
// Reconcile shape, one account per member, any host:
//   CREATE USER IF NOT EXISTS 'member'@'%' IDENTIFIED BY '<password>';
//   ALTER USER 'member'@'%' IDENTIFIED BY '<password>';
//   GRANT <role> TO 'member'@'%';
//   SET DEFAULT ROLE <role> FOR 'member'@'%';
// preceded by the role definitions (shared roles package first, then the
// per-database grant package), with {{dbname}} filled from the schema the
// instance serves (srv/<db>-<GUID>/default.php dbname).
//
// Usage: gen-team-accounts <db> [-n|--dry-run] [--help]

const HELP = <<<'TXT'
Usage: gen-team-accounts <db> [flags]

Reconcile team-member DB accounts (password, no certificate, any host) and
roles for one database, from etc/team.ini + pkg/<db>.roles-<GUID>.

  <db>              instance name (resolves pkg/<db>.roles-<GUID>).
  -n, --dry-run     print the reconcile SQL without applying it.
  -h, --help        show this help.

Role definitions come from the shared pkg/roles-<GUID> package (dependency of
the per-database grant package); member accounts come from etc/team.ini.
TXT;

function pkg_package_dir(string $root, string $name): ?string
{
    $dir = $root . '/pkg/' . $name;
    return is_dir($dir) ? $dir : null;
}

function find_grants_package(string $root, string $db): ?string
{
    $matches = glob($root . '/pkg/' . $db . '.roles-*') ?: [];
    $matches = array_values(array_filter($matches, 'is_dir'));
    if (count($matches) === 1) {
        return $matches[0];
    }
    if (count($matches) === 0) {
        fwrite(STDERR, "gen-team-accounts: no pkg/{$db}.roles-<GUID> package found\n");
    } else {
        fwrite(STDERR, "gen-team-accounts: multiple pkg/{$db}.roles-<GUID> packages found; keep one\n");
    }
    return null;
}

// Load a package's default.php and return its dependencies (list of package
// directory names) from the returned Ema\Config\PackageConfig. The migrated
// value file returns a config object; a missing or legacy (variable-assigning)
// file yields an empty dependency list. PackageConfig types the field as
// `list<string>`, so it needs no re-indexing here.
function package_dependencies(string $dir): array
{
    $default = $dir . '/default.php';
    if (!is_file($default)) {
        return [];
    }
    $config = include $default;
    return $config instanceof \Ema\Config\PackageConfig ? $config->dependencies : [];
}

function read_upgrade_sql(string $dir): string
{
    $sql = is_file($dir . '/upgrade.sql') ? file_get_contents($dir . '/upgrade.sql') : '';
    return $sql === false ? '' : $sql;
}

// Extract role names from CREATE ROLE [IF NOT EXISTS] <name> statements.
function extract_roles(string $sql): array
{
    if (preg_match_all('/\bCREATE\s+ROLE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z0-9_]+)/i', $sql, $m) === false) {
        return [];
    }
    return array_values(array_unique($m[1]));
}

function sql_quote(string $value): string
{
    return str_replace("'", "''", $value);
}

function srv_dbname(string $root, string $instance): string
{
    $matches = glob($root . '/srv/' . $instance . '-*/') ?: [];
    $matches = array_values(array_filter($matches, 'is_dir'));
    if (count($matches) === 1) {
        $default = $matches[0] . '/default.php';
        if (is_file($default)) {
            $config = include $default;
            if ($config instanceof \Ema\Config\DatabaseConfig && $config->dbname !== '') {
                return $config->dbname;
            }
        }
    }
    return $instance;
}

function build_reconcile_sql(string $root, string $db, string $dbname, array $team, string $grantsDir): string
{
    $sql = '-- gen-team-accounts reconcile for `' . $dbname . '` (transient; never persisted)' . PHP_EOL;
    $sql .= PHP_EOL . '-- Role definitions (shared roles package, then per-database grants)' . PHP_EOL;

    $roleNames = [];
    foreach (package_dependencies($grantsDir) as $dep) {
        $dir = pkg_package_dir($root, $dep);
        if ($dir === null) {
            fwrite(STDERR, "gen-team-accounts: dependency package pkg/{$dep} not found\n");
            exit(1);
        }
        $depSql = read_upgrade_sql($dir);
        $roleNames = array_merge($roleNames, extract_roles($depSql));
        $sql .= $depSql . PHP_EOL;
    }
    $sql .= read_upgrade_sql($grantsDir) . PHP_EOL;

    // Fill the database placeholder in the role/grant SQL.
    $sql = str_replace('{{dbname}}', $dbname, $sql);
    $roleNames = array_values(array_unique($roleNames));
    if (count($roleNames) === 0) {
        fwrite(STDERR, "gen-team-accounts: no CREATE ROLE statement found in the roles packages\n");
        exit(1);
    }

    $sql .= PHP_EOL . '-- Member accounts (password, no certificate, any host)' . PHP_EOL;
    foreach ($team as $member => $entries) {
        $password = $entries['password'] ?? null;
        if (!is_string($password) || $password === '') {
            fwrite(STDERR, "gen-team-accounts: member '{$member}' has no 'password' in etc/team.ini\n");
            exit(1);
        }
        $m = sql_quote((string) $member);
        $p = sql_quote($password);
        $sql .= "CREATE USER IF NOT EXISTS '{$m}'@'%' IDENTIFIED BY '{$p}';" . PHP_EOL;
        $sql .= "ALTER USER '{$m}'@'%' IDENTIFIED BY '{$p}';" . PHP_EOL;
        foreach ($roleNames as $role) {
            $sql .= 'GRANT ' . $role . " TO '{$m}'@'%';" . PHP_EOL;
            $sql .= 'SET DEFAULT ROLE ' . $role . " FOR '{$m}'@'%';" . PHP_EOL;
        }
    }

    return $sql;
}

function apply_sql(string $root, string $db, string $sql): int
{
    $tmp = tempnam(sys_get_temp_dir(), 'gen_grants_');
    if ($tmp === false || file_put_contents($tmp, $sql) === false) {
        fwrite(STDERR, "gen-team-accounts: could not write the temporary SQL file\n");
        return 1;
    }
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mdb ' . escapeshellarg($db) . ' < ' . escapeshellarg($tmp);
    passthru($cmd, $code);
    @unlink($tmp);
    return $code;
}

function main(array $argv): int
{
    $root = getcwd();
    if ($root === false) {
        $root = '.';
    }

    // default.php files now return Ema\Config\* instances; make the classes
    // resolvable before the first include (Composer autoloader, at the repo
    // root where this CLI runs).
    require $root . '/vendor/autoload.php';

    $db = null;
    $dryRun = false;
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '-n' || $arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, HELP);
            return 0;
        } elseif ($db === null) {
            $db = $arg;
        } else {
            fwrite(STDERR, "gen-team-accounts: unexpected argument: {$arg}\n");
            return 1;
        }
    }
    if ($db === null) {
        fwrite(STDERR, "gen-team-accounts: missing <db> argument\n");
        fwrite(STDERR, HELP);
        return 1;
    }

    $teamIni = $root . '/etc/team.ini';
    if (!is_file($teamIni)) {
        fwrite(STDERR, "gen-team-accounts: {$teamIni} not found (etc/team.ini is consumer-owned private data — see doc/system/consumer-config.md)\n");
        return 1;
    }
    $team = parse_ini_file($teamIni, true, INI_SCANNER_RAW);
    if (!is_array($team) || count($team) === 0) {
        fwrite(STDERR, "gen-team-accounts: no members in {$teamIni}\n");
        return 1;
    }

    $grantsDir = find_grants_package($root, $db);
    if ($grantsDir === null) {
        return 1;
    }

    $dbname = srv_dbname($root, $db);
    $sql = build_reconcile_sql($root, $db, $dbname, $team, $grantsDir);
    fwrite(STDOUT, $sql);

    if ($dryRun) {
        fwrite(STDERR, "gen-team-accounts: dry-run; SQL printed, not applied\n");
        return 0;
    }

    return apply_sql($root, $db, $sql);
}

exit(main($argv));
