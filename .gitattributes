# Production deploy exclusions: the framework `deploy` CLI ships the repo via
# `git archive`, which honors `export-ignore`. These paths are omitted from
# the deployed tarball while remaining present in dev checkouts. Everything
# the remote needs at runtime (composer.json/lock, src/, pkg/, srv/, etc/,
# bin/ CLIs, LICENSE, README.md) stays in the archive.

# Note: `export-ignore` also affects Composer's prefer-dist and flake archive
# consumers — keep composer.json (+ lock) and flake.nix/flake.lock out of here.

# Linting and git tooling
/.pre-commit-config.yaml export-ignore
/phpstan.dist.neon export-ignore
/hooks/ export-ignore
/tests/ export-ignore
/.gitignore export-ignore

# Dev-only build and environment plumbing
/Makefile export-ignore
# NOTE: bin/dev/ is intentionally NOT export-ignored: init-local-env.sh and
# pf-shell-enter.sh are listed in composer.json's `bin` array, so `composer
# install` (run on the remote from the git archive) must find them to install
# them into vendor/bin. flake.nix/flake.lock are dev-only now (the flake no
# longer ships framework code or re-exports the ema CLI) but stay in the
# archive for the standalone dev shell / template usage.

# Scratch and documentation
/doc/ export-ignore

# Dev machine templates (prod reads /etc/..., not these)
/etc/dev-machines.ini.template export-ignore
/etc/reuter.ini.template export-ignore

# Demo code (not part of a production deploy)
/pkg/demo-*/ export-ignore
/src/scripts/demo/ export-ignore
