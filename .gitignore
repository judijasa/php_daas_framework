/vendor/

/etc/deploy.conf
/etc/dev.conf
/etc/reuter.ini
/etc/ema.conf
/etc/machines.ini
/etc/team.ini
/etc/host-hardening.php
/var/
.env
# Nix build output. `nix build` creates `result` as a symlink, so no trailing
# slash here: a `/result/` rule would only match real directories and leave
# the symlink untracked. `result-*` covers repeated/multi-output builds.
/result
/result-*
.phpstan-result-cache.php
